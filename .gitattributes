# Let git normalise line endings: LF in the repository, native in the working tree.
* text=auto

# Windows-only tooling that must keep CRLF to run correctly when checked out.
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Source and docs stay plain text with LF in the repository.
*.cs text
*.xaml text
*.csproj text
*.slnx text
*.props text
*.json text
*.md text
*.editorconfig text

# Binary assets: never diffed, never line-ending converted.
*.ico binary
*.png binary
*.jpg binary
*.exe binary
*.dll binary
*.zip binary
