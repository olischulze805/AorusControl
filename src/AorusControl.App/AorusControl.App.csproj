<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- DPI awareness lives in app.manifest. WFO0003 asks WinForms apps to use
         ApplicationHighDpiMode instead, but that property only drives WinForms' own
         startup path and writes nothing into a WPF manifest; this app is WPF and hosts
         WinForms only for the tray NotifyIcon, which has no scaled content of its own. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>AorusControl</AssemblyName>
    <RootNamespace>AorusControl.App</RootNamespace>
    <!-- Bump this on every user-visible release; UpdateViewModel reads it back via the
         executing assembly to compare against the update feed's manifest. -->
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AorusControl.Core\AorusControl.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>
</Project>
