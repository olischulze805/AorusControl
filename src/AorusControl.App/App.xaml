<Application x:Class="AorusControl.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Order matters: theme first, then the control styles that read its
                     brushes, then our own overrides below (later definitions win, so
                     WPF-UI's controls pick up this palette without retemplating them). -->
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- ============================ Palette ============================
                 Single source of truth for the whole app, taken from the design
                 canvas. Everything else references these, so a future light theme
                 or a different accent is one block to change, not a search. -->
            <Color x:Key="WindowColor">#FF17181B</Color>
            <Color x:Key="ContentColor">#FF1B1D21</Color>
            <Color x:Key="CardColor">#FF212429</Color>
            <Color x:Key="CardBorderColor">#FF2C3038</Color>
            <Color x:Key="AccentColor">#FF35C7E6</Color>
            <Color x:Key="AccentHoverColor">#FF54D3EE</Color>
            <Color x:Key="AccentPressedColor">#FF1FA7C4</Color>
            <Color x:Key="AccentInkColor">#FF062024</Color>
            <Color x:Key="TextPrimaryColor">#FFF1F3F5</Color>
            <Color x:Key="TextSecondaryColor">#FF9AA3AE</Color>
            <Color x:Key="TextTertiaryColor">#FF6C7480</Color>

            <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}" />
            <SolidColorBrush x:Key="ContentBrush" Color="{StaticResource ContentColor}" />
            <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
            <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
            <SolidColorBrush x:Key="AccentInkBrush" Color="{StaticResource AccentInkColor}" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#2435C7E6" />
            <SolidColorBrush x:Key="AccentSoftStrongBrush" Color="#3835C7E6" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
            <SolidColorBrush x:Key="SubtleFillBrush" Color="#0CFFFFFF" />
            <SolidColorBrush x:Key="SubtleFillHoverBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="TrackBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="TickBrush" Color="#FF454B55" />

            <!-- Semantic status colours: unchanged, these are the values the app has
                 been shipping and the docs quote. -->
            <SolidColorBrush x:Key="SuccessBrush" Color="#4CD787" />
            <SolidColorBrush x:Key="WarningBrush" Color="#F2C94C" />
            <SolidColorBrush x:Key="DangerBrush" Color="#F2555A" />
            <SolidColorBrush x:Key="DangerSoftBrush" Color="#24F2555A" />
            <SolidColorBrush x:Key="DangerTextBrush" Color="#FFFF9CA1" />

            <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
            <CornerRadius x:Key="ControlCornerRadiusSmall">8</CornerRadius>

            <!-- ================= WPF-UI theme overrides =================
                 Retints the framework's own controls (ComboBox, ToggleSwitch,
                 NavigationView, DataGrid, TitleBar) instead of retemplating them.
                 Keys not present in a given WPF-UI version are simply unused. -->
            <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource WindowColor}" />
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource CardColor}" />
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#FF262A31" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource CardBorderColor}" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#0CFFFFFF" />
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource CardBorderColor}" />
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource AccentHoverColor}" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource AccentPressedColor}" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="{StaticResource AccentHoverColor}" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{StaticResource AccentInkColor}" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="{StaticResource AccentInkColor}" />
            <Color x:Key="SystemAccentColor">#FF35C7E6</Color>
            <Color x:Key="SystemAccentColorPrimary">#FF35C7E6</Color>
            <Color x:Key="SystemAccentColorSecondary">#FF54D3EE</Color>
            <Color x:Key="SystemAccentColorTertiary">#FF1FA7C4</Color>
            <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="{StaticResource AccentHoverColor}" />
            <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush" Color="{StaticResource AccentPressedColor}" />

            <!-- ============================ Typography ============================ -->
            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Style>
            <Style x:Key="CardTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Style>
            <Style x:Key="Hint" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,5,0,0" />
                <Setter Property="MaxWidth" Value="820" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
            <Style x:Key="SubLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
                <Setter Property="Margin" Value="0,20,0,0" />
            </Style>
            <Style x:Key="StatusText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,14,0,0" />
            </Style>

            <!-- ============================ Card ============================ -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
                <Setter Property="Padding" Value="22" />
                <Setter Property="Margin" Value="0,0,0,20" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.45" />
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Dashboard tiles: one card shape, four text roles. Sized by the WrapPanel
                 around them rather than by fixed columns, so they reflow instead of squeeze. -->
            <Style x:Key="Tile" TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Padding" Value="18" />
                <!-- TilePanel spaces them; a margin here would double the gaps. -->
                <Setter Property="Margin" Value="0" />
            </Style>
            <Style x:Key="TileLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
            </Style>
            <Style x:Key="TileValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="38" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,4,0,6" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="TileValueSmall" TargetType="TextBlock" BasedOn="{StaticResource TileValue}">
                <Setter Property="FontSize" Value="22" />
                <Setter Property="Margin" Value="0,6,0,6" />
            </Style>
            <Style x:Key="TileLine" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="TileSubLine" TargetType="TextBlock" BasedOn="{StaticResource TileLine}">
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
                <Setter Property="Margin" Value="0,2,0,0" />
            </Style>
            <Style x:Key="InnerPanel" TargetType="Border">
                <Setter Property="Background" Value="#FF0F1113" />
                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <!-- ============================ Buttons ============================ -->
            <Style x:Key="PrimaryButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Appearance" Value="Primary" />
                <Setter Property="Height" Value="38" />
                <Setter Property="Padding" Value="18,0" />
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,10,0" />
            </Style>
            <Style x:Key="SecondaryButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Height" Value="38" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,10,0" />
            </Style>
            <Style x:Key="DangerButton" TargetType="ui:Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                <Setter Property="BorderBrush" Value="#66F2555A" />
                <Setter Property="Foreground" Value="{StaticResource DangerTextBrush}" />
            </Style>

            <!-- ================= Chip: one of a few named, exclusive states =================
                 A RadioButton, not a plain Button: the choices really are mutually
                 exclusive, so the control should carry that meaning (and its
                 IsChecked visual) instead of us tracking a highlight by hand. -->
            <Style x:Key="Chip" TargetType="RadioButton">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,10,10" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Root"
                                    Background="{StaticResource SubtleFillBrush}"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="19"
                                    Height="38"
                                    Padding="16,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                            TextElement.Foreground="{TemplateBinding Foreground}">
                                    <ContentPresenter x:Name="Icon"
                                                      Content="{TemplateBinding Tag}"
                                                      Margin="0,0,8,0"
                                                      VerticalAlignment="Center" />
                                    <ContentPresenter VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource SubtleFillHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoftStrongBrush}" />
                                    <Setter TargetName="Root" Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ================= Icon tile: choose from many equal options ================= -->
            <Style x:Key="IconTile" TargetType="RadioButton">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Margin" Value="0,0,10,10" />
                <Setter Property="Width" Value="104" />
                <Setter Property="Height" Value="84" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Root"
                                    Background="{StaticResource SubtleFillBrush}"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                TextElement.Foreground="{TemplateBinding Foreground}">
                                        <ContentPresenter Content="{TemplateBinding Tag}"
                                                          HorizontalAlignment="Center"
                                                          Margin="0,0,0,8" />
                                        <TextBlock Text="{TemplateBinding Content}"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   FontSize="{TemplateBinding FontSize}"
                                                   FontWeight="{TemplateBinding FontWeight}"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   Margin="6,0" />
                                    </StackPanel>
                                    <!-- Pulsing dot: says "this one is running right now",
                                         so the active effect is readable without looking
                                         at the keyboard itself. -->
                                    <Ellipse x:Name="LiveDot"
                                             Width="7" Height="7"
                                             Fill="{StaticResource AccentBrush}"
                                             HorizontalAlignment="Right" VerticalAlignment="Top"
                                             Margin="0,8,8,0"
                                             Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource SubtleFillHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoftStrongBrush}" />
                                    <Setter TargetName="Root" Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter TargetName="LiveDot" Property="Visibility" Value="Visible" />
                                    <!-- Runs only while this tile is the active one, and is
                                         stopped again on the way out: an animation on a
                                         collapsed element still occupies the render thread. -->
                                    <Trigger.EnterActions>
                                        <BeginStoryboard Name="PulseDot">
                                            <Storyboard RepeatBehavior="Forever" Storyboard.TargetName="LiveDot">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0.35" To="1" Duration="0:0:0.8"
                                                                 AutoReverse="True" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="PulseDot" />
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ================= Zone colour swatch =================
                 A zone colour is a light, not a paint sample, so it is drawn like one: the
                 colour glows outward behind a glossy face instead of sitting in a flat
                 square. The glow is a blurred copy of the same bound Background, so the
                 template carries no colour of its own and nothing can fall out of sync. On
                 hover a dark chip with a pencil appears - legible on top of any colour,
                 which a plain white icon would not be. -->
            <Style x:Key="ZoneSwatch" TargetType="Button">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Width" Value="132" />
                <Setter Property="Height" Value="58" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Margin" Value="0,10,0,8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="16" Margin="10,12,10,4" Opacity="0.5">
                                    <Border.Effect>
                                        <BlurEffect Radius="18" />
                                    </Border.Effect>
                                </Border>
                                <Border x:Name="Face"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="12"
                                        BorderBrush="#2EFFFFFF"
                                        BorderThickness="1">
                                    <Grid>
                                        <Border CornerRadius="11">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#3DFFFFFF" Offset="0" />
                                                    <GradientStop Color="#00FFFFFF" Offset="0.55" />
                                                    <GradientStop Color="#26000000" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border x:Name="EditChip"
                                                Width="30" Height="30" CornerRadius="15"
                                                Background="#B3000000"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Opacity="0">
                                            <ui:SymbolIcon Symbol="Edit24" FontSize="15" Foreground="White" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="EditChip" Property="Opacity" Value="1" />
                                    <Setter TargetName="Face" Property="BorderBrush" Value="#66FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ================= Slider =================
                 For anything that lives on a scale. Ticks sit on the real values, so
                 an unevenly-spaced set of firmware-tested steps looks uneven, which
                 is honest; IsSnapToTickEnabled then makes the invalid values
                 between them unreachable. -->
            <Style x:Key="ValueSlider" TargetType="Slider">
                <Setter Property="Height" Value="38" />
                <Setter Property="IsMoveToPointEnabled" Value="True" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid VerticalAlignment="Center">
                                <Border Height="6" CornerRadius="3" VerticalAlignment="Center"
                                        Margin="11,0"
                                        Background="{StaticResource TrackBrush}" />
                                <!-- ReservedSpace = thumb width, otherwise the ticks drift
                                     away from the thumb towards both ends of the track. -->
                                <TickBar Height="6" VerticalAlignment="Bottom" Margin="0,0,0,-3"
                                         Fill="{StaticResource TickBrush}"
                                         Placement="Bottom"
                                         ReservedSpace="22"
                                         Minimum="{Binding Minimum, RelativeSource={RelativeSource TemplatedParent}}"
                                         Maximum="{Binding Maximum, RelativeSource={RelativeSource TemplatedParent}}"
                                         Ticks="{Binding Ticks, RelativeSource={RelativeSource TemplatedParent}}"
                                         TickFrequency="{Binding TickFrequency, RelativeSource={RelativeSource TemplatedParent}}" />
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <!-- The "already reached" part of the track: the decrease
                                             button is exactly that region, so filling it needs no
                                             second value-to-width conversion. -->
                                        <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="Transparent">
                                                        <Border Height="6" CornerRadius="3" VerticalAlignment="Center"
                                                                Margin="11,0,0,0"
                                                                Background="{StaticResource AccentBrush}" />
                                                    </Border>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="Transparent" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Width="22" Height="22" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Grid>
                                                        <!-- Round halo instead of a square focus rectangle;
                                                             it grows when the slider has keyboard focus. -->
                                                        <Ellipse x:Name="Halo" Width="30" Height="30"
                                                                 Fill="{StaticResource AccentSoftBrush}" />
                                                        <Ellipse Width="22" Height="22"
                                                                 Fill="{StaticResource AccentBrush}"
                                                                 Stroke="#FF14161A" StrokeThickness="3" />
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Value="True"
                                                                     Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=Slider}}">
                                                            <Setter TargetName="Halo" Property="Width" Value="38" />
                                                            <Setter TargetName="Halo" Property="Height" Value="38" />
                                                            <Setter TargetName="Halo" Property="Fill" Value="{StaticResource AccentSoftStrongBrush}" />
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SliderReadout" TargetType="TextBlock">
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="MinWidth" Value="104" />
            </Style>
            <Style x:Key="SliderReadoutSmall" TargetType="TextBlock" BasedOn="{StaticResource SliderReadout}">
                <Setter Property="FontSize" Value="19" />
                <Setter Property="MinWidth" Value="128" />
            </Style>
            <Style x:Key="SliderEndLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
