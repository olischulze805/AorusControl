<ui:FluentWindow x:Class="AorusControl.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:infra="clr-namespace:AorusControl.App.Infrastructure"
                 xmlns:ctrl="clr-namespace:AorusControl.App.Controls"
                 Title="AORUS Control"
                 Icon="Assets/app.ico"
                 Width="1180"
                 Height="880"
                 MinWidth="900"
                 MinHeight="640"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <ui:FluentWindow.Resources>
        <infra:StringEqualsVisibilityConverter x:Key="SectionVisible" />
        <infra:StringEqualsBooleanConverter x:Key="IsSelected" />
        <infra:InverseBoolConverter x:Key="InverseBool" />
        <infra:BoolVisibilityConverter x:Key="BoolVisible" />
        <infra:ActiveOpacityConverter x:Key="ActiveOpacity" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="AORUS Control · AORUS 5 SE · BIOS FB0F" ShowMaximize="True" />

        <ui:NavigationView x:Name="Nav"
                            Grid.Row="1"
                            Background="{StaticResource WindowBrush}"
                            PaneDisplayMode="Left"
                            IsBackButtonVisible="Collapsed"
                            OpenPaneLength="212"
                            SelectionChanged="OnNavigationSelectionChanged">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Dashboard" TargetPageTag="Dashboard" TargetPageType="{x:Type ctrl:DashboardPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Gauge24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Kühlung" TargetPageTag="Cooling" TargetPageType="{x:Type ctrl:CoolingPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="WeatherSnow24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Tastatur" TargetPageTag="Lighting" TargetPageType="{x:Type ctrl:LightingPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Keyboard24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Leistung &amp; Akku" TargetPageTag="Power" TargetPageType="{x:Type ctrl:PowerPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Battery924" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Info &amp; Updates" TargetPageTag="About" TargetPageType="{x:Type ctrl:AboutPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Info24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>

            <ui:NavigationView.ContentOverlay>
            <Grid Background="{StaticResource ContentBrush}">
                <!-- ===================== Dashboard ===================== -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28"
                              Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisible}, ConverterParameter=Dashboard}">
                    <!-- Tiles in WrapPanels rather than a fixed two-column Grid: they reflow from
                         four across to one as the window narrows, instead of being squeezed. The
                         wider cap lets a maximised window actually use its width. -->
                    <StackPanel MaxWidth="1180" HorizontalAlignment="Center">
                        <ctrl:TilePanel MinTileWidth="252" Margin="0,0,0,20">
                            <Border Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="CPU" Style="{StaticResource TileLabel}" />
                                    <TextBlock Text="{Binding CpuTemperature}" Style="{StaticResource TileValue}" />
                                    <TextBlock Text="{Binding CpuFan}" Style="{StaticResource TileLine}" />
                                    <TextBlock Text="{Binding CpuDuty}" Style="{StaticResource TileSubLine}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="GPU" Style="{StaticResource TileLabel}" />
                                    <TextBlock Text="{Binding GpuTemperature}" Style="{StaticResource TileValue}" />
                                    <TextBlock Text="{Binding GpuFan}" Style="{StaticResource TileLine}" />
                                    <TextBlock Text="{Binding GpuDuty}" Style="{StaticResource TileSubLine}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="LÜFTER" Style="{StaticResource TileLabel}" />
                                    <TextBlock Text="{Binding Cooling.ActiveProfile}" Style="{StaticResource TileValueSmall}" />
                                    <TextBlock Text="{Binding Cooling.Summary}" Style="{StaticResource TileLine}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="LEISTUNGSMODUS" Style="{StaticResource TileLabel}" />
                                    <TextBlock Text="{Binding Windows.ActivePowerModeLabel}" Style="{StaticResource TileValueSmall}" />
                                    <TextBlock Text="{Binding Windows.PowerSource}" Style="{StaticResource TileLine}" />
                                    <TextBlock Text="{Binding Windows.PowerStatus}" Style="{StaticResource TileSubLine}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="AKKU" Style="{StaticResource TileLabel}" />
                                    <TextBlock Text="{Binding Battery.SelectedLimit, StringFormat={}{0} %}" Style="{StaticResource TileValueSmall}" />
                                    <TextBlock Text="{Binding Battery.ActivePolicy}" Style="{StaticResource TileLine}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="BELEUCHTUNG" Style="{StaticResource TileLabel}" />
                                    <TextBlock Text="{Binding Keyboard.PowerStateText}" Style="{StaticResource TileValueSmall}" />
                                    <TextBlock Text="{Binding Keyboard.Status}" Style="{StaticResource TileLine}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </ctrl:TilePanel>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" MinWidth="120" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" VerticalAlignment="Center"
                                        Background="{StaticResource AccentSoftBrush}" Margin="0,0,16,0">
                                    <ui:SymbolIcon Symbol="ArrowSync24" FontSize="22" Foreground="{StaticResource AccentBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Live-Überwachung" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="{Binding Status}" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding LastUpdated}" Style="{StaticResource Hint}" />
                                </StackPanel>
                                <ui:Button Grid.Column="2" Style="{StaticResource PrimaryButton}"
                                           Content="{Binding ToggleButtonText}"
                                           Command="{Binding ToggleMonitoringCommand}"
                                           Height="44" MinWidth="180" Margin="16,0,0,0" FontSize="14"
                                           VerticalAlignment="Center">
                                    <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowSync24" /></ui:Button.Icon>
                                </ui:Button>
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource Hint}" HorizontalAlignment="Center" Margin="0,4,0,0"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Text="AORUS 5 SE / FB0F Allowlist · Readback und Rollback für jede Hardwareänderung" />
                    </StackPanel>
                </ScrollViewer>

                <!-- ===================== Kühlung ===================== -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28"
                              Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisible}, ConverterParameter=Cooling}">
                    <StackPanel MaxWidth="880" HorizontalAlignment="Center">

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Lüfterprofil" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Getestete Herstellerprofile. Normal ist der sichere Rückweg und wird bei Absturz automatisch wiederhergestellt. Hervorgehoben ist, was zurückgelesen wurde - nicht, was zuletzt geklickt wurde." />
                                <WrapPanel Margin="0,16,0,-10" IsEnabled="{Binding Cooling.ControlsEnabled}">
                                    <RadioButton Style="{StaticResource Chip}" GroupName="FanProfile" Content="Leise"
                                                 Command="{Binding Cooling.SetProfileCommand}" CommandParameter="Quiet"
                                                 IsChecked="{Binding Cooling.ActiveProfile, Mode=OneWay, Converter={StaticResource IsSelected}, ConverterParameter=Quiet}">
                                        <RadioButton.Tag><ui:SymbolIcon Symbol="LeafOne24" FontSize="16" /></RadioButton.Tag>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="FanProfile" Content="Normal"
                                                 Command="{Binding Cooling.SetProfileCommand}" CommandParameter="Normal"
                                                 IsChecked="{Binding Cooling.ActiveProfile, Mode=OneWay, Converter={StaticResource IsSelected}, ConverterParameter=Normal}">
                                        <RadioButton.Tag><ui:SymbolIcon Symbol="Gauge24" FontSize="16" /></RadioButton.Tag>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="FanProfile" Content="Gaming"
                                                 Command="{Binding Cooling.SetProfileCommand}" CommandParameter="Gaming"
                                                 IsChecked="{Binding Cooling.ActiveProfile, Mode=OneWay, Converter={StaticResource IsSelected}, ConverterParameter=Gaming}">
                                        <RadioButton.Tag><ui:SymbolIcon Symbol="Rocket24" FontSize="16" /></RadioButton.Tag>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="FanProfile" Content="Maximal"
                                                 Command="{Binding Cooling.SetProfileCommand}" CommandParameter="Maximum"
                                                 IsChecked="{Binding Cooling.ActiveProfile, Mode=OneWay, Converter={StaticResource IsSelected}, ConverterParameter=Maximum}">
                                        <RadioButton.Tag><ui:SymbolIcon Symbol="TopSpeed24" FontSize="16" /></RadioButton.Tag>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="FanProfile" Content="Dynamic (eigene Kurve)"
                                                 Command="{Binding Cooling.SetProfileCommand}" CommandParameter="Dynamic"
                                                 IsChecked="{Binding Cooling.ActiveProfile, Mode=OneWay, Converter={StaticResource IsSelected}, ConverterParameter=Dynamic}">
                                        <RadioButton.Tag><ui:SymbolIcon Symbol="ArrowSync24" FontSize="16" /></RadioButton.Tag>
                                    </RadioButton>
                                </WrapPanel>
                                <TextBlock Text="{Binding Cooling.Status}" Style="{StaticResource StatusText}" />

                                <!-- Die Herstellerprofile schreiben keine Kurve: sie setzen vier
                                     Statusflags, die 15 Kurvenpunkte auf der EC bleiben dabei
                                     unverändert. Statt eine Kurve zu erfinden, steht hier, was
                                     währenddessen gemessen wurde. -->
                                <Border Style="{StaticResource InnerPanel}" Margin="0,20,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="200" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,18,0" VerticalAlignment="Center">
                                            <TextBlock Text="Was dieses Profil tut" Style="{StaticResource SubLabel}" />
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" TextWrapping="Wrap"
                                                       Text="{Binding Cooling.ObservationSummary}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" MinWidth="280">
                                            <ctrl:FanCurveChart Measured="{Binding Cooling.ObservedPoints}" Height="150" />
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" HorizontalAlignment="Center"
                                                       Text="Gemessene Lüfterleistung über CPU-Temperatur" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel IsEnabled="{Binding Cooling.ControlsEnabled}">
                                <TextBlock Text="Fester Wert · Fixed-Modus (Test)" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Der Regler rastet auf die acht am Gerät vermessenen Stufen ein - die Marken sitzen dort, wo die Stufen wirklich liegen, deshalb sind die Abstände ungleich. Zwischenwerte sind nicht linear und teils firmwareseitig ungültig, sie lassen sich gar nicht erst wählen. Der Fixed-Modus läuft ausschließlich über den absturzsicheren Hardware-Worker. Aktivieren ist bewusst ein Knopfdruck; läuft Fixed erst einmal, folgt der Regler dann von selbst." />
                                <Grid Margin="0,20,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Cooling.FixedFanPercentText}" Style="{StaticResource SliderReadout}" />
                                    <StackPanel Grid.Column="1" Margin="22,0">
                                        <Slider Style="{StaticResource ValueSlider}" MinWidth="170"
                                                Minimum="25" Maximum="100"
                                                Ticks="{Binding Cooling.FixedFanTicks}"
                                                IsSnapToTickEnabled="True"
                                                Value="{Binding Cooling.FixedFanPercent, Mode=TwoWay}" />
                                        <!-- Ticks on the tested steps, which really are unevenly spaced;
                                             only the two ends are labelled, since the paragraph above
                                             already explains what the lowest step means. -->
                                        <ctrl:SliderScale Minimum="25" Maximum="100" Margin="0,2,0,0"
                                                          Ticks="{Binding Cooling.FixedFanTicks}"
                                                          TickBrush="{StaticResource TickBrush}">
                                            <TextBlock Style="{StaticResource SliderEndLabel}" Text="25 %" />
                                            <TextBlock Style="{StaticResource SliderEndLabel}" Text="100 %" />
                                        </ctrl:SliderScale>
                                    </StackPanel>
                                    <ui:Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Margin="0"
                                               Content="Fixed aktivieren" Command="{Binding Cooling.SetFixedCommand}"
                                               VerticalAlignment="Center">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="Flash24" /></ui:Button.Icon>
                                    </ui:Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel IsEnabled="{Binding Cooling.ControlsEnabled}">
                                <TextBlock Text="Eigene Lüfterkurve" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Punkte ziehen, um Temperatur und Lüfterdrehzahl anzupassen. Kurz nach dem Loslassen schreibt sich die Kurve von selbst auf die EC, aktiviert Dynamic und wird lokal gespeichert - kein Übernehmen-Knopf nötig. Der letzte Punkt ist fest (spätestens 90 °C bei 100 %) - das erzwingt die Firmware." />
                                <TextBlock Text="{Binding Cooling.CurveStatus}" Style="{StaticResource StatusText}" Margin="0,12,0,14" />
                                <Border Style="{StaticResource InnerPanel}">
                                    <!-- Drawn at its real size instead of a fixed canvas in a Viewbox, so the
                                         chart grows with the window without the labels going fuzzy. -->
                                    <ctrl:FanCurveChart Rows="{Binding Cooling.CurveRows}" IsEditable="True"
                                                        Measured="{Binding Cooling.ObservedPoints}"
                                                        MinHeight="220" Height="300" Cursor="Hand"
                                                        CurveEdited="OnFanCurveEdited" />
                                </Border>
                                <!-- Zwei Spuren brauchen eine Legende, sonst sind sie ein Rätsel. -->
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Center">
                                    <Border Width="14" Height="3" CornerRadius="2" VerticalAlignment="Center"
                                            Background="{StaticResource AccentBrush}" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="6,0,18,0" Text="eingestellte Kurve" />
                                    <Border Width="14" Height="3" CornerRadius="2" VerticalAlignment="Center" Background="#FFF2B14C" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="6,0,0,0"
                                               Text="gemessen, während dieses Profil lief" />
                                </StackPanel>
                                <WrapPanel Margin="0,18,0,-10">
                                    <ui:Button Style="{StaticResource SecondaryButton}" Content="Von Firmware neu laden"
                                               Command="{Binding Cooling.ReloadCurveCommand}" Margin="0,0,10,10">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowClockwise24" /></ui:Button.Icon>
                                    </ui:Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===================== Tastatur ===================== -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28"
                              Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisible}, ConverterParameter=Lighting}">
                    <StackPanel MaxWidth="880" HorizontalAlignment="Center">

                        <!-- Zustand, Live-Vorschau, Helligkeit -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Tastaturbeleuchtung" Style="{StaticResource CardTitle}" />
                                        <TextBlock Style="{StaticResource Hint}" MaxWidth="520"
                                                   Text="Die Vorschau rechnet mit derselben Funktion, deren Ergebnis an die Tastatur geschickt wird - sie zeigt den tatsächlichen Frame, keine Nachbildung." />
                                    </StackPanel>
                                    <ui:Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="16,0,0,0"
                                               Content="{Binding Keyboard.PowerButtonText}"
                                               Command="{Binding Keyboard.TogglePowerCommand}"
                                               IsEnabled="{Binding Keyboard.ControlsEnabled}"
                                               VerticalAlignment="Top">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="Power24" /></ui:Button.Icon>
                                    </ui:Button>
                                </Grid>

                                <Border Style="{StaticResource InnerPanel}" Margin="0,16,0,0">
                                    <StackPanel>
                                        <ctrl:KeyboardPreview Zone1Brush="{Binding Keyboard.PreviewZone1Brush}"
                                                              Zone2Brush="{Binding Keyboard.PreviewZone2Brush}"
                                                              Zone3Brush="{Binding Keyboard.PreviewZone3Brush}"
                                                              LightingOpacity="{Binding Keyboard.PreviewOpacity}" />
                                        <Grid Margin="2,8,2,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24*" />
                                                <ColumnDefinition Width="16*" />
                                                <ColumnDefinition Width="36*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{StaticResource SubtleFillBrush}" CornerRadius="4" Height="16" Margin="2,0">
                                                <TextBlock Text="Zone 1" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Border Grid.Column="1" Background="{StaticResource SubtleFillBrush}" CornerRadius="4" Height="16" Margin="2,0">
                                                <TextBlock Text="Zone 2" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Border Grid.Column="2" Background="{StaticResource SubtleFillBrush}" CornerRadius="4" Height="16" Margin="2,0">
                                                <TextBlock Text="Zone 3" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,8,0">
                                                <Ellipse.Style>
                                                    <!-- Pulses only while this section is really
                                                         visible; the sections all stay loaded, so a
                                                         Loaded-triggered animation would never stop. -->
                                                    <Style TargetType="Ellipse">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True">
                                                                <DataTrigger.EnterActions>
                                                                    <BeginStoryboard Name="PulseCaption">
                                                                        <Storyboard RepeatBehavior="Forever">
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                             From="0.35" To="1" Duration="0:0:0.8" AutoReverse="True" />
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </DataTrigger.EnterActions>
                                                                <DataTrigger.ExitActions>
                                                                    <StopStoryboard BeginStoryboardName="PulseCaption" />
                                                                </DataTrigger.ExitActions>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding Keyboard.PreviewCaption}" FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="HELLIGKEIT" Style="{StaticResource SubLabel}" />
                                <!-- Deliberately NOT gated on Keyboard.ControlsEnabled: that flag
                                     goes false for the duration of the write this slider itself
                                     starts, which would disable the control mid-drag and drop the
                                     thumb. The setter already ignores a value while busy and
                                     announces the real position back. -->
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Keyboard.BrightnessLabel}" Style="{StaticResource SliderReadoutSmall}" />
                                    <StackPanel Grid.Column="1" Margin="22,0,0,0">
                                        <Slider Style="{StaticResource ValueSlider}" MinWidth="170"
                                                Minimum="0" Maximum="3" TickFrequency="1"
                                                IsSnapToTickEnabled="True"
                                                Value="{Binding Keyboard.BrightnessIndex, Mode=TwoWay}" />
                                        <ctrl:SliderScale Minimum="0" Maximum="3" Margin="0,2,0,0"
                                                          TickBrush="{StaticResource TickBrush}">
                                            <TextBlock Style="{StaticResource SliderEndLabel}" Text="Aus" />
                                            <TextBlock Style="{StaticResource SliderEndLabel}" Text="Niedrig" />
                                            <TextBlock Style="{StaticResource SliderEndLabel}" Text="Mittel" />
                                            <TextBlock Style="{StaticResource SliderEndLabel}" Text="Hell" />
                                        </ctrl:SliderScale>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding Keyboard.BrightnessEventStatus}" Style="{StaticResource Hint}" Margin="0,14,0,0" />
                                <TextBlock Text="{Binding Keyboard.Status}" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Effekt + Tempo -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Effekt" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Neun host-gerenderte Effekte, plus manuelle Zonenfarben als zehnte Kachel. Die laufende Kachel pulsiert, damit auch ohne Blick auf die Tastatur klar ist, was gerade an ist." />
                                <WrapPanel Margin="0,14,0,-10" IsEnabled="{Binding Keyboard.ControlsEnabled}">
                                    <RadioButton Style="{StaticResource IconTile}" GroupName="Effect" Content="Atmen"
                                                 Command="{Binding Keyboard.ApplyEffectCommand}" CommandParameter="Breathing"
                                                 IsChecked="{Binding Keyboard.ActiveEffectName, Mode=OneWay, Converter={StaticResource IsSelected}, ConverterParameter=Breathing}">
                                        <RadioButton.Tag><ui:SymbolIcon Symbol="Circle24" FontSize="22" /></RadioButton.Tag>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource IconTile}" GroupName="Effect" Content="Pulsieren"
                                                 Command="{Binding Keyboard.ApplyEffectCommand}" CommandParameter="Pulse"
                                                 IsChecked="{Binding Keyboard.ActiveEffectName, Mode=OneWay, Converter={StaticResource IsSelected}, ConverterParameter=Pulse}">
                                        <RadioButton.Tag><ui:SymbolIcon Symbol="Pulse24" FontSize="22" /></RadioButton.Tag>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource IconTile}" GroupName="Effect" Content="Farbwechsel"
                                                 Command="{Binding Keyboard.ApplyEffectCommand}" CommandParameter="ColorCycle"
                                                 IsChecked="{Binding Keyboard.ActiveEffectName, Mode=OneWay, Converter={StaticResource IsSelected}, ConverterParameter=ColorCycle}">
                                        <RadioButton.Tag><ui:SymbolIcon Symbol="ColorBackground24" FontSize="22" /></RadioButton.Tag>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource IconTile}" GroupName="Effect" Content="Regenbogen"
                                                 Command="{Binding Keyboard.ApplyEffectCommand}" CommandParameter="RainbowMarquee"
                                                 IsChecked="{Binding Keyboard.ActiveEffectName, Mode=OneWay, Converter={StaticResource IsSelected}, ConverterParameter=RainbowMarquee}">
                                        <RadioButton.Tag><ui:SymbolIcon Symbol="ColorFill24" FontSize="22" /></RadioButton.Tag>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource IconTile}" GroupName="Effect" Content="Welle"
                                                 Command="{Binding Keyboard.ApplyEffectCommand}" CommandParameter="Wave"
                                                 IsChecked="{Binding Keyboard.ActiveEffectName, Mode=OneWay, Converter={StaticResource IsSelected}, ConverterParameter=Wave}">
                                        <RadioButton.Tag><ui:SymbolIcon Symbol="WeatherSqualls24" FontSize="22" /></RadioButton.Tag>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource IconTile}" GroupName="Effect" Content="Lauflicht"
                                                 Command="{Binding Keyboard.ApplyEffectCommand}" CommandParameter="Marquee"
                                                 IsChecked="{Binding Keyboard.ActiveEffectName, Mode=OneWay, Converter={StaticResource IsSelected}, ConverterParameter=Marquee}">
                                        <RadioButton.Tag><ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="22" /></RadioButton.Tag>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource IconTile}" GroupName="Effect" Content="Pendel"
                                                 Command="{Binding Keyboard.ApplyEffectCommand}" CommandParameter="Rotate"
                                                 IsChecked="{Binding Keyboard.ActiveEffectName, Mode=OneWay, Converter={StaticResource IsSelected}, ConverterParameter=Rotate}">
                                        <RadioButton.Tag><ui:SymbolIcon Symbol="ArrowRepeatAll24" FontSize="22" /></RadioButton.Tag>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource IconTile}" GroupName="Effect" Content="Regentropfen"
                                                 Command="{Binding Keyboard.ApplyEffectCommand}" CommandParameter="Raindrop"
                                                 IsChecked="{Binding Keyboard.ActiveEffectName, Mode=OneWay, Converter={StaticResource IsSelected}, ConverterParameter=Raindrop}">
                                        <RadioButton.Tag><ui:SymbolIcon Symbol="WeatherRain24" FontSize="22" /></RadioButton.Tag>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource IconTile}" GroupName="Effect" Content="Ausblendende Welle"
                                                 Command="{Binding Keyboard.ApplyEffectCommand}" CommandParameter="FadeSweep"
                                                 IsChecked="{Binding Keyboard.ActiveEffectName, Mode=OneWay, Converter={StaticResource IsSelected}, ConverterParameter=FadeSweep}">
                                        <RadioButton.Tag><ui:SymbolIcon Symbol="WeatherPartlyCloudyDay24" FontSize="22" /></RadioButton.Tag>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource IconTile}" GroupName="Effect" Content="Manuell"
                                                 Command="{Binding Keyboard.ApplyEffectCommand}" CommandParameter="Manual"
                                                 IsChecked="{Binding Keyboard.ActiveEffectName, Mode=OneWay, Converter={StaticResource IsSelected}, ConverterParameter=Manual}">
                                        <RadioButton.Tag><ui:SymbolIcon Symbol="Grid24" FontSize="22" /></RadioButton.Tag>
                                    </RadioButton>
                                </WrapPanel>

                                <TextBlock Text="TEMPO" Style="{StaticResource SubLabel}" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Keyboard.SpeedLabel}" Style="{StaticResource SliderReadoutSmall}" />
                                    <StackPanel Grid.Column="1" Margin="22,0,0,0">
                                        <Slider Style="{StaticResource ValueSlider}" MinWidth="170"
                                                Minimum="0" Maximum="4" TickFrequency="1"
                                                IsSnapToTickEnabled="True"
                                                Value="{Binding Keyboard.SpeedIndex, Mode=TwoWay}" />
                                        <ctrl:SliderScale Minimum="0" Maximum="4" Margin="0,2,0,0"
                                                          TickBrush="{StaticResource TickBrush}">
                                            <TextBlock Style="{StaticResource SliderEndLabel}" Text="Sehr langsam" />
                                            <TextBlock Style="{StaticResource SliderEndLabel}" Text="Langsam" />
                                            <TextBlock Style="{StaticResource SliderEndLabel}" Text="Normal" />
                                            <TextBlock Style="{StaticResource SliderEndLabel}" Text="Schnell" />
                                            <TextBlock Style="{StaticResource SliderEndLabel}" Text="Sehr schnell" />
                                        </ctrl:SliderScale>
                                    </StackPanel>
                                </Grid>

                                <ui:Button Style="{StaticResource SecondaryButton}" Content="Auswahl erneut senden"
                                           Command="{Binding Keyboard.ReapplyCommand}"
                                           HorizontalAlignment="Left" Margin="0,20,0,0"
                                           ToolTip="Stellt Farben, Helligkeit und Effekt erneut her, zum Beispiel nach einem Geräte-Reset.">
                                    <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowSync24" /></ui:Button.Icon>
                                </ui:Button>
                            </StackPanel>
                        </Border>

                        <!-- Zonenfarben -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel IsEnabled="{Binding Keyboard.ControlsEnabled}">
                                <TextBlock Text="Zonenfarben" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="{Binding Keyboard.PaletteHint}" Style="{StaticResource Hint}" />
                                <ui:ToggleSwitch Content="Alle drei Zonen gemeinsam ändern"
                                                  IsChecked="{Binding Keyboard.LinkZones, Mode=TwoWay}"
                                                  IsEnabled="{Binding Keyboard.Zone2AffectsLighting}"
                                                  Margin="0,16,0,0" />
                                <!-- A zone the running mode does not read is dimmed rather
                                     than disabled: the colour is still stored and still worth
                                     setting up for manual mode, it simply has no effect right
                                     now. One line below says so once, instead of repeating the
                                     same sentence under all three swatches. -->
                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Keyboard.Zone1Label}" HorizontalAlignment="Center" FontSize="12.5"
                                                   TextWrapping="Wrap" TextAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <Button Tag="1" Click="OnZoneColorClick" Style="{StaticResource ZoneSwatch}"
                                                Background="{Binding Keyboard.Zone1Brush}"
                                                Opacity="{Binding Keyboard.Zone1AffectsLighting, Converter={StaticResource ActiveOpacity}}" />
                                        <TextBlock Text="{Binding Keyboard.Zone1Hex}" HorizontalAlignment="Center" FontSize="11.5"
                                                   FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="Zone 2" HorizontalAlignment="Center" FontSize="12.5"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <Button Tag="2" Click="OnZoneColorClick" Style="{StaticResource ZoneSwatch}"
                                                Background="{Binding Keyboard.Zone2Brush}"
                                                Opacity="{Binding Keyboard.Zone2AffectsLighting, Converter={StaticResource ActiveOpacity}}" />
                                        <TextBlock Text="{Binding Keyboard.Zone2Hex}" HorizontalAlignment="Center" FontSize="11.5"
                                                   FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <TextBlock Text="Zone 3" HorizontalAlignment="Center" FontSize="12.5"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <Button Tag="3" Click="OnZoneColorClick" Style="{StaticResource ZoneSwatch}"
                                                Background="{Binding Keyboard.Zone3Brush}"
                                                Opacity="{Binding Keyboard.Zone3AffectsLighting, Converter={StaticResource ActiveOpacity}}" />
                                        <TextBlock Text="{Binding Keyboard.Zone3Hex}" HorizontalAlignment="Center" FontSize="11.5"
                                                   FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding Keyboard.InactiveZoneNote}" Style="{StaticResource Hint}"
                                           Margin="0,14,0,0" TextAlignment="Center" HorizontalAlignment="Center"
                                           Visibility="{Binding Keyboard.HasInactiveZones, Converter={StaticResource BoolVisible}}" />                      </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===================== Leistung & Akku ===================== -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28"
                              Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisible}, ConverterParameter=Power}">
                    <StackPanel MaxWidth="880" HorizontalAlignment="Center">

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Windows-Leistungsmodus" Style="{StaticResource CardTitle}" />
                                        <TextBlock Style="{StaticResource Hint}" MaxWidth="520"
                                                   Text="Unabhängig vom Lüfterprofil · nur der getestete Netzbetrieb." />
                                    </StackPanel>
                                    <ui:Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="16,0,0,0"
                                               Content="Eigene Profile verwalten …" Click="OnProfilesClick" VerticalAlignment="Top">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="Edit24" /></ui:Button.Icon>
                                    </ui:Button>
                                </Grid>
                                <WrapPanel Margin="0,16,0,-10" IsEnabled="{Binding Windows.PowerControlsEnabled}">
                                    <RadioButton Style="{StaticResource Chip}" GroupName="PowerMode" Content="Energieeffizienz"
                                                 Command="{Binding Windows.SetPowerModeCommand}" CommandParameter="BestEfficiency"
                                                 IsChecked="{Binding Windows.ActivePowerMode, Mode=OneWay, Converter={StaticResource IsSelected}, ConverterParameter=BestEfficiency}">
                                        <RadioButton.Tag><ui:SymbolIcon Symbol="LeafTwo24" FontSize="16" /></RadioButton.Tag>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="PowerMode" Content="Ausbalanciert"
                                                 Command="{Binding Windows.SetPowerModeCommand}" CommandParameter="Balanced"
                                                 IsChecked="{Binding Windows.ActivePowerMode, Mode=OneWay, Converter={StaticResource IsSelected}, ConverterParameter=Balanced}">
                                        <RadioButton.Tag><ui:SymbolIcon Symbol="Gauge24" FontSize="16" /></RadioButton.Tag>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="PowerMode" Content="Beste Leistung"
                                                 Command="{Binding Windows.SetPowerModeCommand}" CommandParameter="BestPerformance"
                                                 IsChecked="{Binding Windows.ActivePowerMode, Mode=OneWay, Converter={StaticResource IsSelected}, ConverterParameter=BestPerformance}">
                                        <RadioButton.Tag><ui:SymbolIcon Symbol="Rocket24" FontSize="16" /></RadioButton.Tag>
                                    </RadioButton>
                                </WrapPanel>
                                <TextBlock Text="{Binding Windows.PowerStatus}" Style="{StaticResource StatusText}" />

                                <!-- What changing the mode really does. Vendor tools tend to imply a
                                     performance mode also drives the fans; on this laptop it does not,
                                     and showing the curve that IS in force next to it is the honest
                                     answer to "what did I just change?". -->
                                <Border Style="{StaticResource InnerPanel}" Margin="0,20,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="240" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,18,0">
                                            <TextBlock Text="Was dieser Modus verändert" Style="{StaticResource SubLabel}" />
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                                       Text="{Binding Windows.PowerModeEffect}" TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource SubLabel}" Margin="0,18,0,0" Text="Kühlung gerade" />
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                                       Text="{Binding Cooling.Summary}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" MinWidth="280">
                                            <ctrl:FanCurveChart Rows="{Binding Cooling.CurveRows}" Height="150" />
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" HorizontalAlignment="Center"
                                                       Text="Kurve auf der EC · änderbar unter Kühlung" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Akku · Ladelimit" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="{Binding Battery.ActivePolicy}" Style="{StaticResource Hint}" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                           Text="Der Regler übernimmt sich selbst, kurz nachdem er zur Ruhe kommt - das Ergebnis wird zurückgelesen und darunter bestätigt." />
                                <Grid Margin="0,20,0,0" IsEnabled="{Binding Battery.CanAdjust}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource SliderReadout}"
                                               Text="{Binding Battery.SelectedLimit, StringFormat={}{0} %}" />
                                    <StackPanel Grid.Column="1" Margin="22,0,0,0">
                                        <Slider Style="{StaticResource ValueSlider}" MinWidth="170"
                                                Minimum="60" Maximum="100" TickFrequency="10"
                                                IsSnapToTickEnabled="False"
                                                Value="{Binding Battery.SelectedLimit, Mode=TwoWay}" />
                                        <ctrl:SliderScale Minimum="60" Maximum="100" Margin="0,2,0,0"
                                                          Ticks="60,70,80,90,100"
                                                          TickBrush="{StaticResource TickBrush}">
                                            <TextBlock Style="{StaticResource SliderEndLabel}" Text="60 %" />
                                            <TextBlock Style="{StaticResource SliderEndLabel}" Text="80 %" />
                                            <TextBlock Style="{StaticResource SliderEndLabel}" Text="100 %" />
                                        </ctrl:SliderScale>
                                    </StackPanel>
                                </Grid>
                                <WrapPanel Margin="0,20,0,-10">
                                    <ui:Button Style="{StaticResource SecondaryButton}" Content="Standardladen"
                                               Command="{Binding Battery.ApplyStandardCommand}"
                                               IsEnabled="{Binding Battery.CanApply}" Margin="0,0,10,10">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowCounterclockwise24" /></ui:Button.Icon>
                                    </ui:Button>
                                    <ui:Button Style="{StaticResource SecondaryButton}" Content="Erneut lesen"
                                               Command="{Binding Battery.RefreshCommand}"
                                               IsEnabled="{Binding Battery.CanRefresh}" Margin="0,0,10,10">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowClockwise24" /></ui:Button.Icon>
                                    </ui:Button>
                                </WrapPanel>
                                <TextBlock Text="{Binding Battery.Status}" Style="{StaticResource StatusText}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===================== Info & Updates ===================== -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28"
                              Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisible}, ConverterParameter=About}">
                    <StackPanel MaxWidth="880" HorizontalAlignment="Center">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="AORUS Control" Style="{StaticResource CardTitle}" />
                                <TextBlock Margin="0,6,0,0" FontSize="13">
                                    <Run Text="Version " /><Run Text="{Binding Updates.CurrentVersion, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="AORUS 5 SE · BIOS FB0F · geprüfte Hardwaregrenzen. Lüfter, Tastatur-RGB, Ladelimit und Windows-Leistungsmodus sind auf dieses genaue Gerät gesperrt; jede Änderung wird zurückgelesen und im Fehlerfall zurückgestellt." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Autostart" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Läuft über eine geplante Aufgabe (nicht den Registry-Autostart), damit bei jedem Login kein neuer Rechte-Dialog erscheint - die Aufgabe ist bereits als erhöht markiert. Beim Anmelden startet die App in den Infobereich, ohne Fenster; über das Symbol dort ist sie jederzeit da." />
                                <TextBlock Text="{Binding Windows.StartupStatus}" Style="{StaticResource StatusText}" />
                                <ui:Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0"
                                           Content="{Binding Windows.StartWithWindowsButtonText}"
                                           Command="{Binding Windows.ToggleStartWithWindowsCommand}">
                                    <ui:Button.Icon><ui:SymbolIcon Symbol="Power24" /></ui:Button.Icon>
                                </ui:Button>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Protokoll" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Jeder Fehler wird mitgeschrieben - auch der des Hardware-Workers, der erhöht und ohne sichtbares Fenster läuft. Eine Datei pro Tag und Prozess, älteres als 14 Tage wird automatisch entfernt." />
                                <TextBlock Text="{Binding Windows.LogDirectory}" Margin="0,12,0,0" FontSize="12"
                                           FontFamily="Consolas" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <ui:Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,14,0,0"
                                           Content="Protokollordner öffnen" Click="OnOpenLogFolderClick">
                                    <ui:Button.Icon><ui:SymbolIcon Symbol="FolderOpen24" /></ui:Button.Icon>
                                </ui:Button>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Updates" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Beim Start wird einmal still nach einer neueren Version gesucht; gemeldet wird nur, wenn es eine gibt. Eine geladene Version wird beim nächsten Start aktiv - oder sofort: &quot;Übernehmen und neu starten&quot; beendet die App geordnet (Lüfter und Beleuchtung gehen an die Firmware zurück), tauscht sie aus und öffnet sie wieder." />
                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="120" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Updates.Status}" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13" />
                                    <ui:Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="16,0,0,0"
                                               Content="Jetzt prüfen"
                                               Command="{Binding Updates.CheckCommand}"
                                               IsEnabled="{Binding Updates.CanCheck}">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowClockwise24" /></ui:Button.Icon>
                                    </ui:Button>
                                </Grid>
                                <WrapPanel Margin="0,14,0,-10">
                                    <ui:Button Style="{StaticResource PrimaryButton}" Margin="0,0,10,10"
                                               Content="Update installieren"
                                               Command="{Binding Updates.InstallCommand}"
                                               IsEnabled="{Binding Updates.CanInstall}"
                                               Visibility="{Binding Updates.HasUpdate, Converter={StaticResource BoolVisible}}">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowDownload24" /></ui:Button.Icon>
                                    </ui:Button>
                                    <ui:Button Style="{StaticResource PrimaryButton}" Margin="0,0,10,10"
                                               Content="Übernehmen und neu starten"
                                               Command="{Binding Updates.RestartCommand}"
                                               Visibility="{Binding Updates.IsDownloaded, Converter={StaticResource BoolVisible}}">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowSync24" /></ui:Button.Icon>
                                    </ui:Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
