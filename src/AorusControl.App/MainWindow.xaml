<ui:FluentWindow x:Class="AorusControl.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:infra="clr-namespace:AorusControl.App.Infrastructure"
                 xmlns:loc="clr-namespace:AorusControl.App.Localization"
                 xmlns:ctrl="clr-namespace:AorusControl.App.Controls"
                 Title="AORUS Control"
                 Icon="Assets/app.ico"
                 Width="1180"
                 Height="880"
                 MinWidth="900"
                 MinHeight="640"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <ui:FluentWindow.Resources>
        <infra:StringEqualsVisibilityConverter x:Key="SectionVisible" />
        <infra:StringEqualsBooleanConverter x:Key="IsSelected" />
        <infra:InverseBoolConverter x:Key="InverseBool" />
        <infra:BoolVisibilityConverter x:Key="BoolVisible" />
        <infra:BoolVisibilityConverter x:Key="InverseBoolVisible" Inverted="True" />
        <infra:ActiveOpacityConverter x:Key="ActiveOpacity" />
        <infra:TemperatureBrushConverter x:Key="TemperatureBrush" />
        <infra:PowerFlowAccentConverter x:Key="FlowAccent" />
        <infra:TextVisibilityConverter x:Key="TextVisible" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="AORUS Control · AORUS 5 SE · BIOS FB0F" ShowMaximize="True" />

        <ui:NavigationView x:Name="Nav"
                            Grid.Row="1"
                            Background="{StaticResource WindowBrush}"
                            PaneDisplayMode="Left"
                            IsBackButtonVisible="Collapsed"
                            OpenPaneLength="212"
                            SelectionChanged="OnNavigationSelectionChanged">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="{loc:T Nav_Dashboard}" TargetPageTag="Dashboard" TargetPageType="{x:Type ctrl:DashboardPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Gauge24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{loc:T Nav_Cooling}" TargetPageTag="Cooling" TargetPageType="{x:Type ctrl:CoolingPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="WeatherSnow24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{loc:T Nav_Keyboard}" TargetPageTag="Lighting" TargetPageType="{x:Type ctrl:LightingPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Keyboard24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{loc:T Nav_Power}" TargetPageTag="Power" TargetPageType="{x:Type ctrl:PowerPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Battery924" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{loc:T Nav_Graphics}" TargetPageTag="Graphics" TargetPageType="{x:Type ctrl:GraphicsPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Desktop24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="{loc:T Nav_About}" TargetPageTag="About" TargetPageType="{x:Type ctrl:AboutPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Info24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>

            <ui:NavigationView.ContentOverlay>
            <Grid Background="{StaticResource ContentBrush}">
                <!-- ===================== Dashboard ===================== -->
                <ScrollViewer Style="{StaticResource SectionPage}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28"
                              Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisible}, ConverterParameter=Dashboard}">
                    <!-- Kein HorizontalAlignment="Center": das gibt der Spalte nur ihre
                         Wunschbreite, und Seiten mit kurzem Inhalt schrumpfen dann auf halbe
                         Breite zusammen. Mit Stretch plus MaxWidth zentriert WPF von selbst. -->
                    <StackPanel MaxWidth="1180">
                        <!-- CPU und GPU stehen vorn und gross: Temperatur und Watt sind das,
                             wofür diese Seite geöffnet wird. Alles andere ist Zustand, der
                             sich selten ändert, und sitzt darunter in kleineren Kacheln.
                             Die Zahlen kommen aus Cooling.Live - dem einzigen Modell, das
                             auch weiss, ob sie noch aktuell sind. -->
                        <ctrl:TilePanel MinTileWidth="430" Gap="16" Margin="0,0,0,16">
                            <Border Style="{StaticResource Tile}" Padding="20,18,20,18">
                                <StackPanel>
                                    <TextBlock Text="CPU" Style="{StaticResource TileLabel}" />
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" MinWidth="60" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource HeroValue}"
                                                   Text="{Binding Cooling.Live.CpuTemperatureText}">
                                            <TextBlock.Foreground>
                                                <MultiBinding Converter="{StaticResource TemperatureBrush}">
                                                    <Binding Path="Cooling.Live.CpuTemperature" />
                                                    <Binding Path="Cooling.Live.IsLive" />
                                                </MultiBinding>
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                        <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Bottom">
                                            <TextBlock Text="{Binding CpuPower}" Style="{StaticResource HeroSecondValue}" />
                                            <TextBlock Text="{loc:T Dash_CpuPackage}" Style="{StaticResource TileSubLine}"
                                                       ToolTip="{loc:T Tip_CpuWatts}" />
                                        </StackPanel>
                                        <ctrl:Sparkline Grid.Column="2" Height="44" Margin="24,4,0,4" MinWidth="60"
                                                        Values="{Binding Cooling.Live.CpuTemperatureHistory}"
                                                        Temperature="{Binding Cooling.Live.CpuTemperature}"
                                                        IsLive="{Binding Cooling.Live.IsLive}"
                                                        ToolTip="{loc:T Tip_TempSparkline}" />
                                    </Grid>
                                    <Grid Margin="0,16,0,0">
                                        <TextBlock Style="{StaticResource TileLine}">
                                            <Run Text="{loc:T Cool_Fans}" Foreground="{StaticResource TextTertiaryBrush}" /><Run Text=" " /><Run Text="{Binding Cooling.Live.CpuRpmText, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Cooling.Live.CpuDutyText}" Style="{StaticResource TileLine}"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                    <ctrl:LevelBar Height="4" Margin="0,8,0,0"
                                                   Value="{Binding Cooling.Live.CpuDuty}"
                                                   Temperature="{Binding Cooling.Live.CpuTemperature}"
                                                   IsLive="{Binding Cooling.Live.IsLive}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tile}" Padding="20,18,20,18">
                                <StackPanel>
                                    <TextBlock Text="GPU" Style="{StaticResource TileLabel}" />
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" MinWidth="60" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource HeroValue}"
                                                   Text="{Binding Cooling.Live.GpuTemperatureText}">
                                            <TextBlock.Foreground>
                                                <MultiBinding Converter="{StaticResource TemperatureBrush}">
                                                    <Binding Path="Cooling.Live.GpuTemperature" />
                                                    <Binding Path="Cooling.Live.IsLive" />
                                                </MultiBinding>
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                        <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Bottom">
                                            <TextBlock Text="{Binding GpuPower}" Style="{StaticResource HeroSecondValue}" />
                                            <TextBlock Text="{Binding GpuPowerStatus}" Style="{StaticResource TileSubLine}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{loc:T Tip_GpuWatts}" />
                                        </StackPanel>
                                        <ctrl:Sparkline Grid.Column="2" Height="44" Margin="24,4,0,4" MinWidth="60"
                                                        Values="{Binding Cooling.Live.GpuTemperatureHistory}"
                                                        Temperature="{Binding Cooling.Live.GpuTemperature}"
                                                        IsLive="{Binding Cooling.Live.IsLive}"
                                                        ToolTip="{loc:T Tip_TempSparkline}" />
                                    </Grid>
                                    <Grid Margin="0,16,0,0">
                                        <TextBlock Style="{StaticResource TileLine}">
                                            <Run Text="{loc:T Cool_Fans}" Foreground="{StaticResource TextTertiaryBrush}" /><Run Text=" " /><Run Text="{Binding Cooling.Live.GpuRpmText, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Cooling.Live.GpuDutyText}" Style="{StaticResource TileLine}"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                    <ctrl:LevelBar Height="4" Margin="0,8,0,0"
                                                   Value="{Binding Cooling.Live.GpuDuty}"
                                                   Temperature="{Binding Cooling.Live.GpuTemperature}"
                                                   IsLive="{Binding Cooling.Live.IsLive}" />
                                </StackPanel>
                            </Border>
                        </ctrl:TilePanel>

                        <!-- Der einzige Gesamtwert, den dieses Gerät messen kann: Was durch
                             den Akku fliesst. Im Akkubetrieb ist das der ganze Verbrauch,
                             am Netz das, was in den Akku geht - die Karte sagt ausdrücklich,
                             welches von beidem gerade dasteht. Die Leistung, die das Netzteil
                             liefert, gibt kein Sensor dieses Laptops her. -->
                        <Border Style="{StaticResource Tile}" Padding="20,18,20,18" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{loc:T Dash_PowerFlow}" Style="{StaticResource TileLabel}" VerticalAlignment="Center" />
                                    <ui:SymbolIcon Style="{StaticResource InfoDot}"
                                                   ToolTip="{loc:T Tip_PowerFlow}" />
                                </StackPanel>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" MinWidth="60" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Bottom">
                                        <TextBlock Text="{Binding PowerFlowValue}" Style="{StaticResource HeroValue}"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding PowerFlowLabel}" Style="{StaticResource TileLine}" Margin="0,2,0,0" />
                                        <!-- Die Zeit steht unter den Watt, weil sie aus ihnen
                                             kommt - und sie verschwindet, sobald die Rate
                                             keine hergibt, statt eine alte stehenzulassen. -->
                                        <TextBlock Text="{Binding PowerFlowRuntime}" Style="{StaticResource TileValueSmall}"
                                                   Margin="0,6,0,0"
                                                   Visibility="{Binding PowerFlowRuntime, Converter={StaticResource TextVisible}}"
                                                   ToolTip="{loc:T Tip_Runtime}" />
                                    </StackPanel>
                                    <!-- Gedeckelt, aber ohne eigene Ausrichtung: eine 900 Pixel
                                         breite Linie bei 20 W Hub sieht aus wie ein Lineal,
                                         und HorizontalAlignment würde sie auf ihre Wunschbreite
                                         schrumpfen lassen - also auf nichts. -->
                                    <ctrl:Sparkline Grid.Column="1" Height="44" Margin="24,4,0,4" MinWidth="60"
                                                    MaxWidth="560"
                                                    Values="{Binding PowerFlowHistory}"
                                                    IsLive="{Binding PowerFlowIsLive}"
                                                    Minimum="0" Maximum="90"
                                                    Accent="{Binding PowerFlowIsCharging, Converter={StaticResource FlowAccent}}"
                                                    ToolTip="{loc:T Tip_FlowSparkline}" />
                                </Grid>
                                <Grid Margin="0,16,0,0">
                                    <TextBlock Text="{Binding PowerFlowNote}" Style="{StaticResource TileLine}"
                                               Visibility="{Binding PowerFlowNote, Converter={StaticResource TextVisible}}" />
                                    <TextBlock Text="{Binding Battery.ActivePolicy}" Style="{StaticResource TileSubLine}"
                                               HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <ctrl:LevelBar Height="4" Margin="0,8,0,0" IsLive="True"
                                               Value="{Binding BatteryCharge}"
                                               Accent="{Binding PowerFlowIsCharging, Converter={StaticResource FlowAccent}}" />
                            </StackPanel>
                        </Border>

                        <ctrl:TilePanel MinTileWidth="212" Margin="0,0,0,20">
                            <Border Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="{loc:T Dash_TileFans}" Style="{StaticResource TileLabel}" />
                                    <TextBlock Text="{Binding Cooling.ActiveProfile}" Style="{StaticResource TileValueSmall}" />
                                    <TextBlock Text="{Binding Cooling.Summary}" Style="{StaticResource TileLine}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="{loc:T Dash_TileMode}" Style="{StaticResource TileLabel}" />
                                    <TextBlock Text="{Binding Windows.ActivePowerModeLabel}" Style="{StaticResource TileValueSmall}" />
                                    <TextBlock Text="{Binding Windows.PowerSource}" Style="{StaticResource TileLine}" />
                                    <TextBlock Text="{Binding Windows.PowerStatus}" Style="{StaticResource TileSubLine}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="{loc:T Dash_TileBattery}" Style="{StaticResource TileLabel}" />
                                    <TextBlock Text="{Binding Battery.SelectedLimit, StringFormat={}{0} %}" Style="{StaticResource TileValueSmall}" />
                                    <TextBlock Text="{Binding Battery.ActivePolicy}" Style="{StaticResource TileLine}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Text="{loc:T Dash_TileLighting}" Style="{StaticResource TileLabel}" />
                                    <TextBlock Text="{Binding Keyboard.PowerStateText}" Style="{StaticResource TileValueSmall}" />
                                    <TextBlock Text="{Binding Keyboard.Status}" Style="{StaticResource TileLine}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </ctrl:TilePanel>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" MinWidth="120" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" VerticalAlignment="Center"
                                        Background="{StaticResource AccentSoftBrush}" Margin="0,0,16,0">
                                    <ui:SymbolIcon Symbol="ArrowSync24" FontSize="22" Foreground="{StaticResource AccentBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T Dash_LiveMonitoring}" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="{Binding Status}" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding LastUpdated}" Style="{StaticResource Hint}" />
                                </StackPanel>
                                <ui:Button Grid.Column="2" Style="{StaticResource PrimaryButton}"
                                           Content="{Binding ToggleButtonText}"
                                           Command="{Binding ToggleMonitoringCommand}"
                                           Height="44" MinWidth="180" Margin="16,0,0,0" FontSize="14"
                                           VerticalAlignment="Center">
                                    <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowSync24" /></ui:Button.Icon>
                                </ui:Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===================== Kühlung ===================== -->
                <ScrollViewer Style="{StaticResource SectionPage}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28"
                              Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisible}, ConverterParameter=Cooling}">
                    <StackPanel MaxWidth="880">

                        <!-- Live: was die Lüfter gerade wirklich tun. Steht bewusst über allem
                             anderen auf dieser Seite - jede Einstellung darunter beantwortet die
                             Frage, die diese Karte stellt, und man sieht die Antwort sofort. -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{loc:T Cool_Live}" Style="{StaticResource CardTitle}" />
                                    <ui:SymbolIcon Style="{StaticResource InfoDot}"
                                                   ToolTip="{loc:T Tip_ThermalPicture}" />
                                </StackPanel>
                                <!-- Das Kühlsystem dieses Geräts, nachgezeichnet: zwei Lüfter, die
                                     Heatpipes dazwischen, die Lamellenpakete und die beiden Chips.
                                     Es ist eine Zeichnung, kein Messbild - aber alles darin hängt an
                                     echten Werten. -->
                                <Border Style="{StaticResource InnerPanel}" Margin="0,18,0,0" Padding="10">
                                    <ctrl:ThermalLayout CpuRpm="{Binding Cooling.Live.CpuRpm}"
                                                        GpuRpm="{Binding Cooling.Live.GpuRpm}"
                                                        CpuDuty="{Binding Cooling.Live.CpuDuty}"
                                                        GpuDuty="{Binding Cooling.Live.GpuDuty}"
                                                        CpuTemperature="{Binding Cooling.Live.CpuTemperature}"
                                                        GpuTemperature="{Binding Cooling.Live.GpuTemperature}"
                                                        IsLive="{Binding Cooling.Live.IsLive}" />
                                </Border>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="{loc:T Cool_CpuFan}" Style="{StaticResource Hint}" Margin="0"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding Cooling.Live.CpuRpmText}" Style="{StaticResource SliderReadoutSmall}"
                                                   MinWidth="0" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                        <TextBlock Style="{StaticResource Hint}" HorizontalAlignment="Center" Margin="0,2,0,0">
                                            <Run Text="{Binding Cooling.Live.CpuTemperatureText, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding Cooling.Live.CpuDutyText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="{loc:T Cool_GpuFan}" Style="{StaticResource Hint}" Margin="0"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding Cooling.Live.GpuRpmText}" Style="{StaticResource SliderReadoutSmall}"
                                                   MinWidth="0" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                        <TextBlock Style="{StaticResource Hint}" HorizontalAlignment="Center" Margin="0,2,0,0">
                                            <Run Text="{Binding Cooling.Live.GpuTemperatureText, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding Cooling.Live.GpuDutyText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{loc:T Cool_Fans}" Style="{StaticResource CardTitle}" />
                                    <ui:SymbolIcon Style="{StaticResource InfoDot}"
                                                   ToolTip="{loc:T Tip_FanProfiles}" />
                                </StackPanel>
                                <WrapPanel Margin="0,16,0,-10" IsEnabled="{Binding Cooling.ControlsEnabled}">
                                    <RadioButton Style="{StaticResource Chip}" GroupName="FanProfile" Content="{loc:T Cool_Quiet}"
                                                 Command="{Binding Cooling.SetProfileCommand}" CommandParameter="Quiet"
                                                 IsChecked="{Binding Cooling.ActiveProfile, Mode=OneWay, Converter={StaticResource IsSelected}, ConverterParameter=Quiet}">
                                        <RadioButton.Tag><ui:SymbolIcon Symbol="LeafOne24" FontSize="16" /></RadioButton.Tag>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="FanProfile" Content="{loc:T Cool_Normal}"
                                                 Command="{Binding Cooling.SetProfileCommand}" CommandParameter="Normal"
                                                 IsChecked="{Binding Cooling.ActiveProfile, Mode=OneWay, Converter={StaticResource IsSelected}, ConverterParameter=Normal}">
                                        <RadioButton.Tag><ui:SymbolIcon Symbol="Gauge24" FontSize="16" /></RadioButton.Tag>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="FanProfile" Content="{loc:T Cool_Gaming}"
                                                 Command="{Binding Cooling.SetProfileCommand}" CommandParameter="Gaming"
                                                 IsChecked="{Binding Cooling.ActiveProfile, Mode=OneWay, Converter={StaticResource IsSelected}, ConverterParameter=Gaming}">
                                        <RadioButton.Tag><ui:SymbolIcon Symbol="Rocket24" FontSize="16" /></RadioButton.Tag>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="FanProfile" Content="{loc:T Cool_Maximum}"
                                                 Command="{Binding Cooling.SetProfileCommand}" CommandParameter="Maximum"
                                                 IsChecked="{Binding Cooling.ActiveProfile, Mode=OneWay, Converter={StaticResource IsSelected}, ConverterParameter=Maximum}">
                                        <RadioButton.Tag><ui:SymbolIcon Symbol="TopSpeed24" FontSize="16" /></RadioButton.Tag>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="FanProfile" Content="{loc:T Cool_Dynamic}"
                                                 Command="{Binding Cooling.SetProfileCommand}" CommandParameter="Dynamic"
                                                 IsChecked="{Binding Cooling.ActiveProfile, Mode=OneWay, Converter={StaticResource IsSelected}, ConverterParameter=Dynamic}">
                                        <RadioButton.Tag><ui:SymbolIcon Symbol="ArrowSync24" FontSize="16" /></RadioButton.Tag>
                                    </RadioButton>
                                </WrapPanel>
                                <TextBlock Text="{Binding Cooling.Status}" Style="{StaticResource StatusText}"
                                           ToolTip="{Binding Cooling.StatusDetail}" />


                                <!-- Ein Diagramm für alle Modi: es zeigt, was der laufende Modus tut,
                                     und lässt sich nur bearbeiten, wenn es die eigene Kurve ist.
                                     Bearbeitbar aussehende Punkte, die nichts bewirken, wären eine
                                     Lüge mit dem Mauszeiger. -->
                                <TextBlock Style="{StaticResource Hint}" Margin="0,20,0,0" TextWrapping="Wrap"
                                           Text="{Binding Cooling.CurveNote}" />
                                <Border Style="{StaticResource InnerPanel}" Margin="0,12,0,0">
                                    <ctrl:FanCurveChart Rows="{Binding Cooling.DisplayedCurve}"
                                                        IsEditable="{Binding Cooling.IsCurveEditable}"
                                                        ConstantPercent="{Binding Cooling.ConstantPercent}"
                                                        LiveTemperature="{Binding Cooling.Live.MarkerTemperature}"
                                                        LivePercent="{Binding Cooling.Live.MarkerPercent}"
                                                        CurveEdited="OnFanCurveEdited"
                                                        MinHeight="220" Height="300" />
                                </Border>
                                <!-- Zwei Einträge, aber nie beide: entweder die Kurve regelt gerade,
                                     oder sie liegt nur gespeichert daneben. -->
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Center">
                                    <Border Width="14" Height="3" CornerRadius="2" VerticalAlignment="Center"
                                            Background="{StaticResource AccentBrush}"
                                            Visibility="{Binding Cooling.ShowsActiveLine, Converter={StaticResource BoolVisible}}" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="6,0,18,0" Text="{loc:T Cool_CurveActive}"
                                               Visibility="{Binding Cooling.ShowsActiveLine, Converter={StaticResource BoolVisible}}" />
                                    <Border Width="14" Height="3" CornerRadius="2" VerticalAlignment="Center" Background="#FF8A939B"
                                            Visibility="{Binding Cooling.IsCurveEditable, Converter={StaticResource InverseBoolVisible}}" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="6,0,0,0" Text="{loc:T Cool_CurveSaved}"
                                               Visibility="{Binding Cooling.IsCurveEditable, Converter={StaticResource InverseBoolVisible}}" />
                                    <Ellipse Width="9" Height="9" Fill="White" VerticalAlignment="Center" Margin="18,0,0,0"
                                             Visibility="{Binding Cooling.Live.IsLive, Converter={StaticResource BoolVisible}}" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="6,0,0,0" Text="{loc:T Cool_CurveMeasured}"
                                               Visibility="{Binding Cooling.Live.IsLive, Converter={StaticResource BoolVisible}}" />
                                    <!-- Die Bedienung der Kurve steht dort, wo man sie bedient, und
                                         nur dann, wenn sie sich überhaupt bedienen lässt. -->
                                    <ui:SymbolIcon Style="{StaticResource InfoDot}" Margin="16,0,0,0"
                                                   Visibility="{Binding Cooling.IsCurveEditable, Converter={StaticResource BoolVisible}}"
                                                   ToolTip="{loc:T Tip_CurveEditor}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Cooling.CurveStatus}" Style="{StaticResource StatusText}" Margin="0,12,0,0" />
                                <WrapPanel Margin="0,10,0,-10" IsEnabled="{Binding Cooling.IsCurveEditable}">
                                    <ui:Button Style="{StaticResource PrimaryButton}" Content="{loc:T Cool_ApplyCurve}"
                                               Command="{Binding Cooling.ApplyCurveCommand}"
                                               IsEnabled="{Binding Cooling.CanApplyCurve}" Margin="0,0,10,10">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="Save24" /></ui:Button.Icon>
                                    </ui:Button>
                                    <ui:Button Style="{StaticResource SecondaryButton}" Content="{loc:T Cool_LoadGigabyteCurve}"
                                               Command="{Binding Cooling.LoadGigabyteCurveCommand}" Margin="0,0,10,10">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowImport24" /></ui:Button.Icon>
                                    </ui:Button>
                                    <ui:Button Style="{StaticResource SecondaryButton}" Content="{loc:T Cool_SaveCurve}"
                                               Click="OnSaveFanCurveClick" Margin="0,0,10,10" />
                                    <ui:Button Style="{StaticResource SecondaryButton}" Content="{loc:T Cool_OpenCurve}"
                                               Click="OnLoadFanCurveClick" Margin="0,0,10,10" />
                                    <ui:Button Style="{StaticResource SecondaryButton}" Content="{loc:T Cool_DiscardAndReread}"
                                               Command="{Binding Cooling.ReloadCurveCommand}" Margin="0,0,10,10">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowClockwise24" /></ui:Button.Icon>
                                    </ui:Button>
                                </WrapPanel>
                                <!-- Der feste Wert gehört in dieselbe Karte: er ist eine weitere
                                     Antwort auf dieselbe Frage, nämlich wie die Lüfter gerade laufen
                                     sollen - nur eine, die die Kurve außer Kraft setzt. -->
                                <Border Height="1" Background="{StaticResource CardBorderBrush}" Margin="0,24,0,20" />
                                <!-- Ein Schalter, kein Knopf: Festgesetzte Lüfter sind der Zustand
                                     dieser App, der am dringendsten ablesbar und von dort aus
                                     wieder verlassbar sein muss. Vorher führte der Knopf nur
                                     hinein - heraus kam man nur, wenn man wusste, dass ein
                                     Profil-Chip weiter oben die Sperre nebenbei freigibt.
                                     Der Schalter ist zugleich die Überschrift des Abschnitts:
                                     zwei Beschriftungen für dieselbe Sache wären eine zu viel. -->
                                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                    <ui:ToggleSwitch Content="{loc:T Cool_FixedValue}" VerticalAlignment="Center"
                                                     IsEnabled="{Binding Cooling.ControlsEnabled}"
                                                     IsChecked="{Binding Cooling.IsFixedOn, Mode=TwoWay}" />
                                    <ui:SymbolIcon Style="{StaticResource InfoDot}" FontSize="13" VerticalAlignment="Center"
                                                   ToolTip="{loc:T Tip_FixedFan}" />
                                </StackPanel>
                                <Grid Margin="0,20,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Cooling.FixedFanPercentText}" Style="{StaticResource SliderReadout}" />
                                    <StackPanel Grid.Column="1" Margin="22,0,0,0">
                                        <Slider Style="{StaticResource ValueSlider}" MinWidth="170"
                                                Minimum="0" Maximum="100" SmallChange="1" LargeChange="5"
                                                Value="{Binding Cooling.FixedFanPercent, Mode=TwoWay}" />
                                        <!-- Eine gleichmässige Skala, weil der Regler jetzt auch
                                             gleichmässig ist; beschriftet sind nur die Enden. -->
                                        <ctrl:SliderScale Minimum="0" Maximum="100" Margin="0,2,0,0"
                                                          Ticks="0,25,50,75,100"
                                                          TickBrush="{StaticResource TickBrush}">
                                            <TextBlock Style="{StaticResource SliderEndLabel}" Text="{loc:T Common_Off}" />
                                            <TextBlock Style="{StaticResource SliderEndLabel}" Text="100 %" />
                                        </ctrl:SliderScale>
                                    </StackPanel>
                                </Grid>

                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- ===================== Tastatur ===================== -->
                <ScrollViewer Style="{StaticResource SectionPage}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28"
                              Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisible}, ConverterParameter=Lighting}">
                    <StackPanel MaxWidth="880">

                        <!-- Zustand, Live-Vorschau, Helligkeit -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{loc:T Key_Lighting}" Style="{StaticResource CardTitle}" />
                                            <ui:SymbolIcon Style="{StaticResource InfoDot}"
                                                           ToolTip="{loc:T Tip_KeyboardPreview}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <ui:Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="16,0,0,0"
                                               Content="{Binding Keyboard.PowerButtonText}"
                                               Command="{Binding Keyboard.TogglePowerCommand}"
                                               IsEnabled="{Binding Keyboard.ControlsEnabled}"
                                               VerticalAlignment="Top">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="Power24" /></ui:Button.Icon>
                                    </ui:Button>
                                </Grid>

                                <Border Style="{StaticResource InnerPanel}" Margin="0,16,0,0">
                                    <StackPanel>
                                        <ctrl:KeyboardPreview Zone1Brush="{Binding Keyboard.PreviewZone1Brush}"
                                                              Zone2Brush="{Binding Keyboard.PreviewZone2Brush}"
                                                              Zone3Brush="{Binding Keyboard.PreviewZone3Brush}"
                                                              LightingOpacity="{Binding Keyboard.PreviewOpacity}" />
                                        <Grid Margin="2,8,2,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24*" />
                                                <ColumnDefinition Width="16*" />
                                                <ColumnDefinition Width="36*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{StaticResource SubtleFillBrush}" CornerRadius="4" Height="16" Margin="2,0">
                                                <TextBlock Text="Zone 1" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Border Grid.Column="1" Background="{StaticResource SubtleFillBrush}" CornerRadius="4" Height="16" Margin="2,0">
                                                <TextBlock Text="Zone 2" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Border Grid.Column="2" Background="{StaticResource SubtleFillBrush}" CornerRadius="4" Height="16" Margin="2,0">
                                                <TextBlock Text="Zone 3" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,8,0">
                                                <Ellipse.Style>
                                                    <!-- Pulses only while this section is really
                                                         visible; the sections all stay loaded, so a
                                                         Loaded-triggered animation would never stop. -->
                                                    <Style TargetType="Ellipse">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True">
                                                                <DataTrigger.EnterActions>
                                                                    <BeginStoryboard Name="PulseCaption">
                                                                        <Storyboard RepeatBehavior="Forever">
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                             From="0.35" To="1" Duration="0:0:0.8" AutoReverse="True" />
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </DataTrigger.EnterActions>
                                                                <DataTrigger.ExitActions>
                                                                    <StopStoryboard BeginStoryboardName="PulseCaption" />
                                                                </DataTrigger.ExitActions>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding Keyboard.PreviewCaption}" FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{loc:T Key_Brightness}" Style="{StaticResource SubLabel}" />
                                <!-- Deliberately NOT gated on Keyboard.ControlsEnabled: that flag
                                     goes false for the duration of the write this slider itself
                                     starts, which would disable the control mid-drag and drop the
                                     thumb. The setter already ignores a value while busy and
                                     announces the real position back. -->
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Keyboard.BrightnessLabel}" Style="{StaticResource SliderReadoutSmall}" />
                                    <StackPanel Grid.Column="1" Margin="22,0,0,0">
                                        <Slider Style="{StaticResource ValueSlider}" MinWidth="170"
                                                Minimum="0" Maximum="3" TickFrequency="1"
                                                IsSnapToTickEnabled="True"
                                                Value="{Binding Keyboard.BrightnessIndex, Mode=TwoWay}" />
                                        <ctrl:SliderScale Minimum="0" Maximum="3" Margin="0,2,0,0"
                                                          TickBrush="{StaticResource TickBrush}">
                                            <TextBlock Style="{StaticResource SliderEndLabel}" Text="{loc:T Common_Off}" />
                                            <TextBlock Style="{StaticResource SliderEndLabel}" Text="{loc:T Key_Low}" />
                                            <TextBlock Style="{StaticResource SliderEndLabel}" Text="{loc:T Key_Medium}" />
                                            <TextBlock Style="{StaticResource SliderEndLabel}" Text="{loc:T Key_Bright}" />
                                        </ctrl:SliderScale>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding Keyboard.BrightnessEventStatus}" Style="{StaticResource Hint}" Margin="0,14,0,0"
                                           Visibility="{Binding Keyboard.BrightnessEventStatus, Converter={StaticResource TextVisible}}" />
                                <TextBlock Text="{Binding Keyboard.Status}" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Effekt + Tempo -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{loc:T Key_Effect}" Style="{StaticResource CardTitle}" />
                                    <ui:SymbolIcon Style="{StaticResource InfoDot}"
                                                   ToolTip="{loc:T Tip_Effects}" />
                                </StackPanel>
                                <WrapPanel Margin="0,14,0,-10" IsEnabled="{Binding Keyboard.ControlsEnabled}">
                                    <RadioButton Style="{StaticResource IconTile}" GroupName="Effect" Content="{loc:T Key_EffectBreathing}"
                                                 Command="{Binding Keyboard.ApplyEffectCommand}" CommandParameter="Breathing"
                                                 IsChecked="{Binding Keyboard.ActiveEffectName, Mode=OneWay, Converter={StaticResource IsSelected}, ConverterParameter=Breathing}">
                                        <RadioButton.Tag><ui:SymbolIcon Symbol="Circle24" FontSize="22" /></RadioButton.Tag>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource IconTile}" GroupName="Effect" Content="{loc:T Key_EffectPulse}"
                                                 Command="{Binding Keyboard.ApplyEffectCommand}" CommandParameter="Pulse"
                                                 IsChecked="{Binding Keyboard.ActiveEffectName, Mode=OneWay, Converter={StaticResource IsSelected}, ConverterParameter=Pulse}">
                                        <RadioButton.Tag><ui:SymbolIcon Symbol="Pulse24" FontSize="22" /></RadioButton.Tag>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource IconTile}" GroupName="Effect" Content="{loc:T Key_EffectColorCycle}"
                                                 Command="{Binding Keyboard.ApplyEffectCommand}" CommandParameter="ColorCycle"
                                                 IsChecked="{Binding Keyboard.ActiveEffectName, Mode=OneWay, Converter={StaticResource IsSelected}, ConverterParameter=ColorCycle}">
                                        <RadioButton.Tag><ui:SymbolIcon Symbol="ColorBackground24" FontSize="22" /></RadioButton.Tag>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource IconTile}" GroupName="Effect" Content="{loc:T Key_EffectRainbow}"
                                                 Command="{Binding Keyboard.ApplyEffectCommand}" CommandParameter="RainbowMarquee"
                                                 IsChecked="{Binding Keyboard.ActiveEffectName, Mode=OneWay, Converter={StaticResource IsSelected}, ConverterParameter=RainbowMarquee}">
                                        <RadioButton.Tag><ui:SymbolIcon Symbol="ColorFill24" FontSize="22" /></RadioButton.Tag>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource IconTile}" GroupName="Effect" Content="{loc:T Key_EffectWave}"
                                                 Command="{Binding Keyboard.ApplyEffectCommand}" CommandParameter="Wave"
                                                 IsChecked="{Binding Keyboard.ActiveEffectName, Mode=OneWay, Converter={StaticResource IsSelected}, ConverterParameter=Wave}">
                                        <RadioButton.Tag><ui:SymbolIcon Symbol="WeatherSqualls24" FontSize="22" /></RadioButton.Tag>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource IconTile}" GroupName="Effect" Content="{loc:T Key_EffectMarquee}"
                                                 Command="{Binding Keyboard.ApplyEffectCommand}" CommandParameter="Marquee"
                                                 IsChecked="{Binding Keyboard.ActiveEffectName, Mode=OneWay, Converter={StaticResource IsSelected}, ConverterParameter=Marquee}">
                                        <RadioButton.Tag><ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="22" /></RadioButton.Tag>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource IconTile}" GroupName="Effect" Content="{loc:T Key_EffectSwing}"
                                                 Command="{Binding Keyboard.ApplyEffectCommand}" CommandParameter="Rotate"
                                                 IsChecked="{Binding Keyboard.ActiveEffectName, Mode=OneWay, Converter={StaticResource IsSelected}, ConverterParameter=Rotate}">
                                        <RadioButton.Tag><ui:SymbolIcon Symbol="ArrowRepeatAll24" FontSize="22" /></RadioButton.Tag>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource IconTile}" GroupName="Effect" Content="{loc:T Key_EffectRaindrop}"
                                                 Command="{Binding Keyboard.ApplyEffectCommand}" CommandParameter="Raindrop"
                                                 IsChecked="{Binding Keyboard.ActiveEffectName, Mode=OneWay, Converter={StaticResource IsSelected}, ConverterParameter=Raindrop}">
                                        <RadioButton.Tag><ui:SymbolIcon Symbol="WeatherRain24" FontSize="22" /></RadioButton.Tag>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource IconTile}" GroupName="Effect" Content="{loc:T Key_EffectFadingWave}"
                                                 Command="{Binding Keyboard.ApplyEffectCommand}" CommandParameter="FadeSweep"
                                                 IsChecked="{Binding Keyboard.ActiveEffectName, Mode=OneWay, Converter={StaticResource IsSelected}, ConverterParameter=FadeSweep}">
                                        <RadioButton.Tag><ui:SymbolIcon Symbol="WeatherPartlyCloudyDay24" FontSize="22" /></RadioButton.Tag>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource IconTile}" GroupName="Effect" Content="{loc:T Key_EffectManual}"
                                                 Command="{Binding Keyboard.ApplyEffectCommand}" CommandParameter="Manual"
                                                 IsChecked="{Binding Keyboard.ActiveEffectName, Mode=OneWay, Converter={StaticResource IsSelected}, ConverterParameter=Manual}">
                                        <RadioButton.Tag><ui:SymbolIcon Symbol="Grid24" FontSize="22" /></RadioButton.Tag>
                                    </RadioButton>
                                </WrapPanel>

                                <TextBlock Text="{loc:T Key_Speed}" Style="{StaticResource SubLabel}" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Keyboard.SpeedLabel}" Style="{StaticResource SliderReadoutSmall}" />
                                    <StackPanel Grid.Column="1" Margin="22,0,0,0">
                                        <Slider Style="{StaticResource ValueSlider}" MinWidth="170"
                                                Minimum="0" Maximum="4" TickFrequency="1"
                                                IsSnapToTickEnabled="True"
                                                Value="{Binding Keyboard.SpeedIndex, Mode=TwoWay}" />
                                        <ctrl:SliderScale Minimum="0" Maximum="4" Margin="0,2,0,0"
                                                          TickBrush="{StaticResource TickBrush}">
                                            <TextBlock Style="{StaticResource SliderEndLabel}" Text="{loc:T Key_SpeedVerySlow}" />
                                            <TextBlock Style="{StaticResource SliderEndLabel}" Text="{loc:T Key_SpeedSlow}" />
                                            <TextBlock Style="{StaticResource SliderEndLabel}" Text="{loc:T Cool_Normal}" />
                                            <TextBlock Style="{StaticResource SliderEndLabel}" Text="{loc:T Key_SpeedFast}" />
                                            <TextBlock Style="{StaticResource SliderEndLabel}" Text="{loc:T Key_SpeedVeryFast}" />
                                        </ctrl:SliderScale>
                                    </StackPanel>
                                </Grid>

                                <ui:Button Style="{StaticResource SecondaryButton}" Content="{loc:T Key_Resend}"
                                           Command="{Binding Keyboard.ReapplyCommand}"
                                           HorizontalAlignment="Left" Margin="0,20,0,0"
                                           ToolTip="{loc:T Tip_Resend}">
                                    <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowSync24" /></ui:Button.Icon>
                                </ui:Button>
                            </StackPanel>
                        </Border>

                        <!-- Zonenfarben -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel IsEnabled="{Binding Keyboard.ControlsEnabled}">
                                <TextBlock Text="{loc:T Key_ZoneColours}" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="{Binding Keyboard.PaletteHint}" Style="{StaticResource Hint}" />
                                <ui:ToggleSwitch Content="{loc:T Key_AllZonesTogether}"
                                                  IsChecked="{Binding Keyboard.LinkZones, Mode=TwoWay}"
                                                  IsEnabled="{Binding Keyboard.Zone2AffectsLighting}"
                                                  Margin="0,16,0,0" />
                                <!-- A zone the running mode does not read is dimmed rather
                                     than disabled: the colour is still stored and still worth
                                     setting up for manual mode, it simply has no effect right
                                     now. One line below says so once, instead of repeating the
                                     same sentence under all three swatches. -->
                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Keyboard.Zone1Label}" HorizontalAlignment="Center" FontSize="12.5"
                                                   TextWrapping="Wrap" TextAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <Button Tag="1" Click="OnZoneColorClick" Style="{StaticResource ZoneSwatch}"
                                                Background="{Binding Keyboard.Zone1Brush}"
                                                Opacity="{Binding Keyboard.Zone1AffectsLighting, Converter={StaticResource ActiveOpacity}}" />
                                        <TextBlock Text="{Binding Keyboard.Zone1Hex}" HorizontalAlignment="Center" FontSize="11.5"
                                                   FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="Zone 2" HorizontalAlignment="Center" FontSize="12.5"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <Button Tag="2" Click="OnZoneColorClick" Style="{StaticResource ZoneSwatch}"
                                                Background="{Binding Keyboard.Zone2Brush}"
                                                Opacity="{Binding Keyboard.Zone2AffectsLighting, Converter={StaticResource ActiveOpacity}}" />
                                        <TextBlock Text="{Binding Keyboard.Zone2Hex}" HorizontalAlignment="Center" FontSize="11.5"
                                                   FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <TextBlock Text="Zone 3" HorizontalAlignment="Center" FontSize="12.5"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <Button Tag="3" Click="OnZoneColorClick" Style="{StaticResource ZoneSwatch}"
                                                Background="{Binding Keyboard.Zone3Brush}"
                                                Opacity="{Binding Keyboard.Zone3AffectsLighting, Converter={StaticResource ActiveOpacity}}" />
                                        <TextBlock Text="{Binding Keyboard.Zone3Hex}" HorizontalAlignment="Center" FontSize="11.5"
                                                   FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding Keyboard.InactiveZoneNote}" Style="{StaticResource Hint}"
                                           Margin="0,14,0,0" TextAlignment="Center" HorizontalAlignment="Center"
                                           Visibility="{Binding Keyboard.HasInactiveZones, Converter={StaticResource BoolVisible}}" />                      </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===================== Leistung & Akku ===================== -->
                <ScrollViewer Style="{StaticResource SectionPage}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28"
                              Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisible}, ConverterParameter=Power}">
                    <StackPanel MaxWidth="880">

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{loc:T Pwr_WindowsMode}" Style="{StaticResource CardTitle}" />
                                            <ui:SymbolIcon Style="{StaticResource InfoDot}"
                                                           ToolTip="{Binding Windows.PowerModeTooltip}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                                <WrapPanel Margin="0,16,0,-10" IsEnabled="{Binding Windows.PowerControlsEnabled}">
                                    <RadioButton Style="{StaticResource Chip}" GroupName="PowerMode" Content="{loc:T Pwr_ModeEfficiency}"
                                                 Command="{Binding Windows.SetPowerModeCommand}" CommandParameter="BestEfficiency"
                                                 IsChecked="{Binding Windows.ActivePowerMode, Mode=OneWay, Converter={StaticResource IsSelected}, ConverterParameter=BestEfficiency}">
                                        <RadioButton.Tag><ui:SymbolIcon Symbol="LeafTwo24" FontSize="16" /></RadioButton.Tag>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="PowerMode" Content="{loc:T Pwr_ModeBalanced}"
                                                 Command="{Binding Windows.SetPowerModeCommand}" CommandParameter="Balanced"
                                                 IsChecked="{Binding Windows.ActivePowerMode, Mode=OneWay, Converter={StaticResource IsSelected}, ConverterParameter=Balanced}">
                                        <RadioButton.Tag><ui:SymbolIcon Symbol="Gauge24" FontSize="16" /></RadioButton.Tag>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="PowerMode" Content="{loc:T Pwr_ModeBestPerformance}"
                                                 Command="{Binding Windows.SetPowerModeCommand}" CommandParameter="BestPerformance"
                                                 IsChecked="{Binding Windows.ActivePowerMode, Mode=OneWay, Converter={StaticResource IsSelected}, ConverterParameter=BestPerformance}">
                                        <RadioButton.Tag><ui:SymbolIcon Symbol="Rocket24" FontSize="16" /></RadioButton.Tag>
                                    </RadioButton>
                                </WrapPanel>
                                <TextBlock Text="{Binding Windows.PowerStatus}" Style="{StaticResource StatusText}" />

                            </StackPanel>
                        </Border>

                        <!-- Der Akkusparmodus. Geschrieben wird nur die Akku-Seite eines
                             eigenen Plans, deshalb braucht es weder eine Automatik noch eine
                             Bedingung: am Netz ändert er nichts, der Schalter kann anbleiben. -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{loc:T Saver_Title}" Style="{StaticResource CardTitle}" />
                                        <ui:SymbolIcon Style="{StaticResource InfoDot}" ToolTip="{loc:T Tip_BatterySaver}" />
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                                     IsChecked="{Binding Saver.IsOn, Mode=TwoWay}"
                                                     IsEnabled="{Binding Saver.CanSwitch}" />
                                </Grid>
                                <TextBlock Text="{Binding Saver.Savings}" Style="{StaticResource Hint}" TextWrapping="Wrap" />

                                <Grid Margin="0,18,0,0" IsEnabled="{Binding Saver.CanAdjust}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:T Saver_Brightness}" Style="{StaticResource TileLabel}"
                                               VerticalAlignment="Center" MinWidth="124" Margin="0,0,10,0" />
                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Saver.BrightnessText}" Style="{StaticResource TileValueSmall}"
                                                   VerticalAlignment="Center" MinWidth="58" />
                                        <Slider Grid.Column="1" Style="{StaticResource ValueSlider}" MinWidth="150" Margin="8,0,0,0"
                                                Minimum="10" Maximum="100" SmallChange="5" LargeChange="10"
                                                Value="{Binding Saver.Brightness, Mode=TwoWay}" />
                                    </Grid>
                                </Grid>
                                <Grid Margin="0,12,0,0" IsEnabled="{Binding Saver.CanAdjust}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:T Saver_CpuCap}" Style="{StaticResource TileLabel}"
                                               VerticalAlignment="Center" MinWidth="124" Margin="0,0,10,0" />
                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Saver.ProcessorCapText}" Style="{StaticResource TileValueSmall}"
                                                   VerticalAlignment="Center" MinWidth="58" />
                                        <Slider Grid.Column="1" Style="{StaticResource ValueSlider}" MinWidth="150" Margin="8,0,0,0"
                                                Minimum="30" Maximum="100" SmallChange="5" LargeChange="10"
                                                Value="{Binding Saver.ProcessorCap, Mode=TwoWay}" />
                                    </Grid>
                                </Grid>
                                <TextBlock Text="{Binding Saver.Status}" Style="{StaticResource StatusText}"
                                           Visibility="{Binding Saver.Status, Converter={StaticResource TextVisible}}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{loc:T Bat_Title}" Style="{StaticResource CardTitle}" />
                                    <ui:SymbolIcon Style="{StaticResource InfoDot}"
                                                   ToolTip="{loc:T Tip_ChargeLimit}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Battery.ActivePolicy}" Style="{StaticResource Hint}" />
                                <!-- Zwei sich ausschließende Zustände, die sofort gelten: ein
                                     Schalter. Vorher war es ein Knopf „Standardladen", der nur
                                     in eine Richtung führte - zurück kam man nur, indem man am
                                     Regler wackelte, bis die App es merkte. -->
                                <ui:ToggleSwitch Margin="0,16,0,0" Content="{loc:T Bat_ChargeLimit}"
                                                 IsEnabled="{Binding Battery.CanAdjust}"
                                                 IsChecked="{Binding Battery.IsLimitEnabled, Mode=TwoWay}" />
                                <Grid Margin="0,20,0,0" IsEnabled="{Binding Battery.CanAdjustLimit}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource SliderReadout}"
                                               Text="{Binding Battery.SelectedLimit, StringFormat={}{0} %}" />
                                    <StackPanel Grid.Column="1" Margin="22,0,0,0">
                                        <Slider Style="{StaticResource ValueSlider}" MinWidth="170"
                                                Minimum="60" Maximum="100" TickFrequency="10"
                                                IsSnapToTickEnabled="False"
                                                Value="{Binding Battery.SelectedLimit, Mode=TwoWay}" />
                                        <ctrl:SliderScale Minimum="60" Maximum="100" Margin="0,2,0,0"
                                                          Ticks="60,70,80,90,100"
                                                          TickBrush="{StaticResource TickBrush}">
                                            <TextBlock Style="{StaticResource SliderEndLabel}" Text="60 %" />
                                            <TextBlock Style="{StaticResource SliderEndLabel}" Text="80 %" />
                                            <TextBlock Style="{StaticResource SliderEndLabel}" Text="100 %" />
                                        </ctrl:SliderScale>
                                    </StackPanel>
                                </Grid>
                                <WrapPanel Margin="0,20,0,-10">
                                    <!-- „Erneut lesen" bleibt ein Knopf: Das ist keine
                                         Einstellung, sondern eine Handlung. -->
                                    <ui:Button Style="{StaticResource SecondaryButton}" Content="{loc:T Common_ReRead}"
                                               Command="{Binding Battery.RefreshCommand}"
                                               IsEnabled="{Binding Battery.CanRefresh}" Margin="0,0,10,10">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowClockwise24" /></ui:Button.Icon>
                                    </ui:Button>
                                </WrapPanel>
                                <TextBlock Text="{Binding Battery.Status}" Style="{StaticResource StatusText}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===================== Grafik ===================== -->
                <ScrollViewer Style="{StaticResource SectionPage}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28"
                              Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisible}, ConverterParameter=Graphics}">
                    <StackPanel MaxWidth="880">
                        <!-- Die Beobachtung vor der Einstellung: Die Karte darunter zeigt
                             gespeicherte Wünsche, diese hier zeigt den Ist-Zustand. Ohne sie
                             muss man raten, welche Programme überhaupt interessant sind. -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                        <!-- Gekürzt, sonst läuft der Titel bei 720 Pixeln unter
                                             den Knopf rechts daneben. -->
                                        <TextBlock Text="{loc:T Gpu_WhoUsesWhat}" Style="{StaticResource CardTitle}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <ui:SymbolIcon Style="{StaticResource InfoDot}"
                                                       ToolTip="{loc:T Tip_GpuActivity}" />
                                    </StackPanel>
                                    <ui:Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="{loc:T Common_Refresh}"
                                               VerticalAlignment="Center"
                                               Command="{Binding Graphics.RefreshRunningCommand}">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowSync24" /></ui:Button.Icon>
                                    </ui:Button>
                                </Grid>
                                <TextBlock Text="{Binding Graphics.RunningSummary}" Style="{StaticResource Hint}" />

                                <ItemsControl ItemsSource="{Binding Graphics.Running}" Margin="0,14,0,-8"
                                              Visibility="{Binding Graphics.HasRunning, Converter={StaticResource BoolVisible}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DataTemplate.Resources>
                                                <!-- Die RTX hebt sich ab, die Intel-Grafik nicht: Die eine ist
                                                     der Grund, warum man hier nachsieht, die andere der
                                                     Normalfall. -->
                                                <Style x:Key="ChipPill" TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource SubtleFillBrush}" />
                                                    <Setter Property="CornerRadius" Value="6" />
                                                    <Setter Property="Padding" Value="9,3" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="MinWidth" Value="86" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNvidia}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AccentSoftStrongBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                                <Style x:Key="ChipText" TargetType="TextBlock">
                                                    <Setter Property="FontSize" Value="11.5" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                                    <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNvidia}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataTemplate.Resources>
                                            <Border Style="{StaticResource InnerPanel}" Margin="0,0,0,8" Padding="14,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource ChipPill}">
                                                        <TextBlock Text="{Binding Chip}" Style="{StaticResource ChipText}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" Margin="0,3,0,0"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"
                                                                   Visibility="{Binding Detail, Converter={StaticResource TextVisible}}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                VerticalAlignment="Center" Margin="14,0,0,0">
                                                        <!-- Beenden steht links, kleiner und ohne
                                                             Beschriftung: Es hilft jetzt, aber nur
                                                             jetzt. Die Regel daneben ist die
                                                             dauerhafte Antwort und bekommt deshalb
                                                             das Wort. -->
                                                        <ui:Button Style="{StaticResource SecondaryButton}"
                                                                   Visibility="{Binding CanClose, Converter={StaticResource BoolVisible}}"
                                                                   ToolTip="{loc:T Tip_CloseProgram}"
                                                                   Command="{Binding DataContext.Graphics.CloseRunningCommand,
                                                                                     RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                   CommandParameter="{Binding}">
                                                            <ui:Button.Icon><ui:SymbolIcon Symbol="Dismiss24" /></ui:Button.Icon>
                                                        </ui:Button>
                                                        <ui:Button Style="{StaticResource SecondaryButton}" Content="{loc:T Common_Adopt}"
                                                                   Margin="8,0,0,0"
                                                                   Visibility="{Binding CanAdd, Converter={StaticResource BoolVisible}}"
                                                                   Command="{Binding DataContext.Graphics.AddRunningCommand,
                                                                                     RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                   CommandParameter="{Binding}">
                                                            <ui:Button.Icon><ui:SymbolIcon Symbol="Add24" /></ui:Button.Icon>
                                                        </ui:Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{loc:T Gpu_PerPowerSource}" Style="{StaticResource CardTitle}" />
                                        <ui:SymbolIcon Style="{StaticResource InfoDot}"
                                                       ToolTip="{loc:T Tip_GpuRules}" />
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                                     IsChecked="{Binding Graphics.IsAutomatic, Mode=TwoWay}"
                                                     Content="{loc:T Gpu_Automatic}" />
                                </Grid>
                                <TextBlock Text="{Binding Graphics.SourceText}" Style="{StaticResource Hint}" />

                                <TextBlock Style="{StaticResource SubLabel}" Margin="0,16,0,0" Text="{loc:T Gpu_Suggested}"
                                           Visibility="{Binding Graphics.HasSuggestions, Converter={StaticResource BoolVisible}}" />
                                <ItemsControl ItemsSource="{Binding Graphics.Suggestions}" Margin="0,14,0,0"
                                              Visibility="{Binding Graphics.HasSuggestions, Converter={StaticResource BoolVisible}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource InnerPanel}" Margin="0,0,0,8" Padding="14,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="13.5" FontWeight="SemiBold"
                                                                   ToolTip="{Binding Path}" />
                                                        <TextBlock Text="{Binding State}" Style="{StaticResource Hint}" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                    <ui:Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="{loc:T Common_Adopt}"
                                                               VerticalAlignment="Center" Margin="14,0,0,0"
                                                               Command="{Binding DataContext.Graphics.AddSuggestionCommand,
                                                                                 RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                               CommandParameter="{Binding}">
                                                        <ui:Button.Icon><ui:SymbolIcon Symbol="Add24" /></ui:Button.Icon>
                                                    </ui:Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Graphics.LeftoverNote}" Style="{StaticResource Hint}"
                                           Visibility="{Binding Graphics.LeftoverNote, Converter={StaticResource TextVisible}}" />

                                <ItemsControl ItemsSource="{Binding Graphics.Programs}" Margin="0,14,0,0"
                                              Visibility="{Binding Graphics.HasPrograms, Converter={StaticResource BoolVisible}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource InnerPanel}" Margin="0,0,0,8" Padding="14,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="13.5" FontWeight="SemiBold"
                                                                   ToolTip="{Binding Path}" />
                                                        <TextBlock Text="{Binding State}" Style="{StaticResource Hint}" Margin="0,3,0,0" />
                                                        <!-- Zwei Regeln pro Programm: ein Browser gehört auch am Netz
                                                             auf die Intel-Grafik, ein Spiel auch am Akku auf die RTX.
                                                             Die feste Kopplung konnte beides nicht. -->
                                                        <!-- WrapPanel, nicht nebeneinander erzwungen: bei 720
                                                             Pixeln bleibt neben dem Entfernen-Knopf keine Breite
                                                             für zwei Felder, und eines abgeschnitten ist
                                                             schlimmer als zwei untereinander. -->
                                                        <WrapPanel Margin="0,10,0,-8"
                                                                   Visibility="{Binding HasRules, Converter={StaticResource BoolVisible}}">
                                                            <!-- Beschriftung neben dem Feld statt darüber: spart je
                                                                 Zeile eine Textzeile, und "Netz"/"Akku" sind kurz
                                                                 genug, dass daneben Platz bleibt. -->
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                                                                <TextBlock Text="{loc:T Gpu_OnMains}" Style="{StaticResource TileLabel}" MinWidth="62"
                                                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                <ComboBox MinWidth="146"
                                                                          ItemsSource="{Binding Choices}"
                                                                          DisplayMemberPath="Text" SelectedValuePath="Value"
                                                                          SelectedValue="{Binding OnAc, Mode=TwoWay}" />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                                <TextBlock Text="{loc:T Dash_TileBattery}" Style="{StaticResource TileLabel}" MinWidth="62"
                                                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                <ComboBox MinWidth="146"
                                                                          ItemsSource="{Binding Choices}"
                                                                          DisplayMemberPath="Text" SelectedValuePath="Value"
                                                                          SelectedValue="{Binding OnBattery, Mode=TwoWay}" />
                                                            </StackPanel>
                                                        </WrapPanel>
                                                    </StackPanel>
                                                    <ui:Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="{loc:T Common_Remove}"
                                                               VerticalAlignment="Top" Margin="14,0,0,0"
                                                               Command="{Binding DataContext.Graphics.RemoveCommand,
                                                                                 RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                               CommandParameter="{Binding}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <WrapPanel Margin="0,10,0,-10">
                                    <ui:Button Style="{StaticResource SecondaryButton}" Content="{loc:T Gpu_AddProgram}"
                                               Click="OnAddGpuProgramClick" Margin="0,0,10,10">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="Add24" /></ui:Button.Icon>
                                    </ui:Button>
                                    <ui:Button Style="{StaticResource SecondaryButton}" Content="{loc:T Gpu_ApplyNow}"
                                               Command="{Binding Graphics.ApplyNowCommand}" Margin="0,0,10,10">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowSync24" /></ui:Button.Icon>
                                    </ui:Button>
                                </WrapPanel>
                                <TextBlock Text="{Binding Graphics.Status}" Style="{StaticResource StatusText}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===================== Info & Updates ===================== -->
                <ScrollViewer Style="{StaticResource SectionPage}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28"
                              Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisible}, ConverterParameter=About}">
                    <StackPanel MaxWidth="880">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="AORUS Control" Style="{StaticResource CardTitle}" />
                                    <ui:SymbolIcon Style="{StaticResource InfoDot}"
                                                   ToolTip="{loc:T Tip_DeviceScope}" />
                                </StackPanel>
                                <TextBlock Margin="0,6,0,0" FontSize="13">
                                    <Run Text="{loc:T About_Version}" /><Run Text="{Binding Updates.CurrentVersion, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Hint}" Text="AORUS 5 SE · BIOS FB0F" />
                            </StackPanel>
                        </Border>

                        <!-- Sprache: ein Auswahlfeld in einer Karte, wie Microsoft es auch
                             fuer die Hell/Dunkel-Wahl vorsieht. Sofort wirksam, ohne Neustart -
                             die Texte haengen an einem Indexer, der sich neu meldet. -->
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T About_Language}" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="{loc:T About_LanguageHint}" Style="{StaticResource Hint}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" MinWidth="180" VerticalAlignment="Center" Margin="16,0,0,0"
                                          ItemsSource="{Binding Language.Choices}"
                                          DisplayMemberPath="Text" SelectedValuePath="Value"
                                          SelectedValue="{Binding Language.Selected, Mode=TwoWay}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{loc:T About_Autostart}" Style="{StaticResource CardTitle}" />
                                    <ui:SymbolIcon Style="{StaticResource InfoDot}"
                                                   ToolTip="{loc:T Tip_Autostart}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Windows.StartupStatus}" Style="{StaticResource StatusText}" />
                                <ui:Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0"
                                           Content="{Binding Windows.StartWithWindowsButtonText}"
                                           Command="{Binding Windows.ToggleStartWithWindowsCommand}">
                                    <ui:Button.Icon><ui:SymbolIcon Symbol="Power24" /></ui:Button.Icon>
                                </ui:Button>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{loc:T About_Log}" Style="{StaticResource CardTitle}" />
                                    <ui:SymbolIcon Style="{StaticResource InfoDot}"
                                                   ToolTip="{loc:T Tip_Log}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Windows.LogDirectory}" Margin="0,12,0,0" FontSize="12"
                                           FontFamily="Consolas" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <ui:Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,14,0,0"
                                           Content="{loc:T About_OpenLogFolder}" Click="OnOpenLogFolderClick">
                                    <ui:Button.Icon><ui:SymbolIcon Symbol="FolderOpen24" /></ui:Button.Icon>
                                </ui:Button>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{loc:T About_Updates}" Style="{StaticResource CardTitle}" />
                                    <ui:SymbolIcon Style="{StaticResource InfoDot}"
                                                   ToolTip="{loc:T Tip_Updates}" />
                                </StackPanel>
                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="120" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Updates.Status}" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13" />
                                    <ui:Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="16,0,0,0"
                                               Content="{loc:T About_CheckNow}"
                                               Command="{Binding Updates.CheckCommand}"
                                               IsEnabled="{Binding Updates.CanCheck}">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowClockwise24" /></ui:Button.Icon>
                                    </ui:Button>
                                </Grid>
                                <WrapPanel Margin="0,14,0,-10">
                                    <ui:Button Style="{StaticResource PrimaryButton}" Margin="0,0,10,10"
                                               Content="{loc:T About_InstallUpdate}"
                                               Command="{Binding Updates.InstallCommand}"
                                               IsEnabled="{Binding Updates.CanInstall}"
                                               Visibility="{Binding Updates.HasUpdate, Converter={StaticResource BoolVisible}}">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowDownload24" /></ui:Button.Icon>
                                    </ui:Button>
                                    <ui:Button Style="{StaticResource PrimaryButton}" Margin="0,0,10,10"
                                               Content="{loc:T About_ApplyAndRestart}"
                                               Command="{Binding Updates.RestartCommand}"
                                               Visibility="{Binding Updates.IsDownloaded, Converter={StaticResource BoolVisible}}">
                                        <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowSync24" /></ui:Button.Icon>
                                    </ui:Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
