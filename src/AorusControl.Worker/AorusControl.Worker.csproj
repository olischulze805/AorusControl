<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Windowless: the worker serves for as long as Fixed mode is held, so a console
         Exe left a black window in the user's way. ConsoleAttach restores CLI output. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../AorusControl.Core/AorusControl.Core.csproj" />
  </ItemGroup>
</Project>
