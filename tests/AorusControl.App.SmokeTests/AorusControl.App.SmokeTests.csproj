<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../TestProcessSettings.cs" Link="TestProcessSettings.cs" />
    <ProjectReference Include="../../src/AorusControl.Core/AorusControl.Core.csproj" />
    <Compile Include="../../src/AorusControl.App/ViewModels/*.cs" Link="ViewModels/%(Filename)%(Extension)" />
    <Compile Include="../../src/AorusControl.App/Infrastructure/*.cs" Link="Infrastructure/%(Filename)%(Extension)" />
    <!-- Das Vokabular beider Sprachen: der Test vergleicht ihre Schluessel gegeneinander. -->
    <Compile Include="../../src/AorusControl.App/Localization/*.cs" Link="Localization/%(Filename)%(Extension)" />
    <!-- Feature modules, one folder each: a new module is compiled here without editing this file. -->
    <!-- Same packages the linked App sources need. -->
    <PackageReference Include="Velopack" Version="1.2.0" />
    <Compile Include="../../src/AorusControl.App/Features/**/*.cs" Link="Features/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../src/AorusControl.App/Controls/KeyboardLayout.cs" Link="Controls/%(Filename)%(Extension)" />
    <!-- Die Temperaturrampe: der Konverter im Infrastructure-Ordner färbt die Dashboard-Zahlen damit. -->
    <Compile Include="../../src/AorusControl.App/Controls/ThermalPalette.cs" Link="Controls/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
